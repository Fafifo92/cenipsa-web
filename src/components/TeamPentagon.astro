---
/**
 * Infografía «Un Equipo Interdisciplinario al Servicio de la Verdad»:
 * pentágono de cinco disciplinas alrededor de «La Verdad Procesal».
 * SVG con trazos que se dibujan al entrar en pantalla y núcleo pulsante.
 * En móvil: núcleo arriba y disciplinas en lista.
 */
export interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';

// Vértices del pentágono (viewBox 1000 × 640), empezando arriba y en sentido horario.
const cx = 500;
const cy = 330;
const r = 215;
const pts = [0, 1, 2, 3, 4].map((k) => {
  const a = (-90 + k * 72) * (Math.PI / 180);
  return { x: cx + r * Math.cos(a), y: cy + r * Math.sin(a) };
});
const poly = pts.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
const star = [0, 2, 4, 1, 3].map((k) => `${pts[k].x.toFixed(1)},${pts[k].y.toFixed(1)}`).join(' ');

const items = isEs
  ? [
      { title: 'Derecho', text: 'Penal, civil, comercial, laboral y familia.' },
      { title: 'Investigación Criminal', text: 'Balística, documentología y manejo de cadena de custodia.' },
      { title: 'Ingeniería Electrónica', text: 'Auditoría forense digital, correlación de datos y hardware táctico.' },
      { title: 'Peritaje Forense', text: 'Experticia con método científico para asesorar a jueces y tribunales.' },
      { title: 'Ciencias Sociales', text: 'Sociología, antropología, trabajo social forense y perfilamiento del comportamiento humano.' },
    ]
  : [
      { title: 'Law', text: 'Criminal, civil, commercial, labor and family.' },
      { title: 'Criminal Investigation', text: 'Ballistics, document examination and chain-of-custody management.' },
      { title: 'Electronic Engineering', text: 'Digital forensic audit, data correlation and tactical hardware.' },
      { title: 'Forensic Expertise', text: 'Scientific-method expertise to advise judges and courts.' },
      { title: 'Social Sciences', text: 'Sociology, anthropology, forensic social work and human behavior profiling.' },
    ];
const t = isEs
  ? { title: 'Un Equipo Interdisciplinario al Servicio de la Verdad', core1: 'La Verdad', core2: 'Procesal' }
  : { title: 'An Interdisciplinary Team Serving the Truth', core1: 'Procedural', core2: 'Truth' };

// Posición de cada tarjeta (escritorio) alrededor del pentágono, en % del contenedor.
const slots = [
  'left-1/2 top-0 -translate-x-1/2 text-center',
  'right-0 top-[38%] text-left',
  'right-[2%] bottom-0 text-left',
  'left-[2%] bottom-0 text-right',
  'left-0 top-[38%] text-right',
];
---

<figure class="team-pentagon relative overflow-hidden rounded-3xl bg-ink-950 px-5 py-10 text-white shadow-lift md:px-10 md:py-12" data-reveal>
  <div class="tp-grid pointer-events-none absolute inset-0 opacity-[0.06]" aria-hidden="true"></div>
  <figcaption class="relative text-center font-display text-2xl font-semibold md:text-3xl">{t.title}</figcaption>

  <!-- Escritorio: diagrama -->
  <div class="relative mx-auto mt-8 hidden aspect-[1000/640] max-w-5xl lg:block">
    <svg class="absolute inset-0 h-full w-full" viewBox="0 0 1000 640" aria-hidden="true">
      <circle cx={cx} cy={cy} r={r + 40} class="tp-ring" />
      <circle cx={cx} cy={cy} r={r - 70} class="tp-ring" />
      <polygon points={poly} class="tp-line tp-line--white" pathLength="100" />
      <polygon points={star} class="tp-line tp-line--gold" pathLength="100" />
      {pts.map((p) => <line x1={cx} y1={cy} x2={p.x} y2={p.y} class="tp-spoke" pathLength="100" />)}
      {pts.map((p) => <circle cx={p.x} cy={p.y} r="9" class="tp-node" />)}
      <circle cx={cx} cy={cy} r="92" class="tp-core-glow" />
      <circle cx={cx} cy={cy} r="78" class="tp-core" />
      <text x={cx} y={cy - 6} text-anchor="middle" class="tp-core-text">{t.core1}</text>
      <text x={cx} y={cy + 24} text-anchor="middle" class="tp-core-text">{t.core2}</text>
    </svg>
    {
      items.map((it, i) => (
        <div class:list={['tp-card absolute w-[27%] rounded-xl border border-gold-400/50 bg-ink-950/85 px-4 py-3 backdrop-blur-sm', slots[i]]} style={`--i:${i}`}>
          <p class="font-display text-lg font-semibold text-gold-400">{it.title}</p>
          <p class="mt-1 text-[0.86rem] leading-relaxed text-ink-100">{it.text}</p>
        </div>
      ))
    }
  </div>

  <!-- Móvil / tableta -->
  <div class="relative mt-8 lg:hidden">
    <div class="tp-core-mobile mx-auto flex h-36 w-36 items-center justify-center rounded-full bg-gold-400 text-center font-display text-lg font-semibold text-ink-950">
      {t.core1}<br />{t.core2}
    </div>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        items.map((it) => (
          <li class="rounded-xl border border-gold-400/50 bg-white/[0.04] px-4 py-3">
            <p class="font-display text-lg font-semibold text-gold-400">{it.title}</p>
            <p class="mt-1 text-[0.9rem] leading-relaxed text-ink-100">{it.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</figure>

<style>
  .tp-grid {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.6) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.6) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse at 50% 50%, black 30%, transparent 75%);
  }
  .tp-ring {
    fill: none;
    stroke: rgb(201 165 54 / 0.18);
    stroke-width: 1.5;
    stroke-dasharray: 4 8;
  }
  .tp-line,
  .tp-spoke {
    fill: none;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 1.6s var(--ease-out-expo);
  }
  .tp-line--white {
    stroke: rgb(255 255 255 / 0.75);
    stroke-width: 2.5;
  }
  .tp-line--gold {
    stroke: var(--color-gold-400);
    stroke-width: 1.8;
    transition-delay: 0.35s;
  }
  .tp-spoke {
    stroke: rgb(201 165 54 / 0.45);
    stroke-width: 1.2;
    transition-delay: 0.6s;
  }
  .team-pentagon.is-visible .tp-line,
  .team-pentagon.is-visible .tp-spoke,
  :global(html:not(.js)) .tp-line,
  :global(html:not(.js)) .tp-spoke {
    stroke-dashoffset: 0;
  }
  .tp-node {
    fill: #fff;
    stroke: var(--color-gold-400);
    stroke-width: 4;
  }
  .tp-core {
    fill: var(--color-gold-400);
  }
  .tp-core-glow {
    fill: rgb(201 165 54 / 0.25);
    transform-origin: 500px 330px;
    animation: tp-pulse 3.2s ease-in-out infinite;
  }
  .tp-core-text {
    fill: var(--color-ink-950);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 26px;
  }
  .tp-core-mobile {
    box-shadow: 0 0 0 10px rgb(201 165 54 / 0.18), 0 0 40px rgb(201 165 54 / 0.45);
  }
  @keyframes tp-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.6;
    }
    50% {
      transform: scale(1.12);
      opacity: 0.25;
    }
  }
  :global(html.js) .team-pentagon:not(.is-visible) .tp-card {
    opacity: 0;
    filter: blur(4px);
  }
  :global(html.js) .tp-card {
    transition:
      opacity 0.8s var(--ease-out-expo),
      filter 0.8s var(--ease-out-expo);
    transition-delay: calc(var(--i, 0) * 140ms + 700ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .tp-core-glow {
      animation: none;
    }
    .tp-line,
    .tp-spoke {
      stroke-dashoffset: 0;
      transition: none;
    }
  }
</style>
