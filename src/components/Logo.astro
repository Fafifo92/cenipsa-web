---
/**
 * Logotipo CENIPSA (columna + huella). Imagen con fondo transparente:
 * - variant="dark": tinta azul, para fondos claros.
 * - variant="light": tinta blanca + dorado, para fondos azules.
 * - full: incluye el eslogan «Investigamos la verdad. Defendemos sus derechos.».
 */
export interface Props {
  variant?: 'dark' | 'light';
  full?: boolean;
  class?: string;
}
const { variant = 'dark', full = false, class: className = '' } = Astro.props;
const name = `logo-cenipsa-${full ? 'full' : 'mark'}${variant === 'light' ? '-light' : ''}.png`;
const [width, height] = full ? [900, 236] : [720, 151];
---

<img
  src={`/images/${name}`}
  width={width}
  height={height}
  alt="CENIPSA — Investigamos la verdad. Defendemos sus derechos."
  class:list={['h-auto w-auto select-none', className || (full ? 'h-16' : 'h-10 md:h-11')]}
  decoding="async"
/>
