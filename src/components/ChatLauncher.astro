---
/**
 * Launcher de chat propio: sustituye el botón por defecto de Tawk.to con uno
 * acorde a la estética del sitio y con animaciones de entrada, hover y
 * apertura/cierre. Controla el panel de Tawk vía Tawk_API (ver thirdparty.ts).
 * Si Tawk no responde (bloqueado por un ad-blocker, caído, etc.), el botón
 * ofrece WhatsApp como alternativa en vez de quedar sin reacción.
 *
 * El botón en sí es el único elemento que determina la posición fija
 * (bottom-6 right-6, igual que WhatsAppButton): la burbuja de saludo y el
 * tooltip van con position:absolute para nunca alterar esa caja, evitando
 * que el botón quede desalineado respecto al de WhatsApp.
 */
import { CONTACT } from '@/lib/site';

export interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;
const label = lang === 'es' ? '¿Necesitas ayuda? Chatea con nosotros' : 'Need help? Chat with us';
const bubble = lang === 'es' ? 'Estamos en línea' : "We're online";
---

<div
  id="chat-launcher"
  class="fixed bottom-6 right-6 z-40"
  data-state="idle"
  data-whatsapp={CONTACT.whatsappHref}
>
  <!-- Burbuja de saludo: absoluta, no afecta la posición del botón -->
  <div
    id="chat-bubble"
    class="chat-bubble pointer-events-none absolute right-0 bottom-full mb-3 max-w-[15rem] origin-bottom-right rounded-2xl rounded-br-sm border border-ink-100 bg-white px-4 py-2.5 text-[0.85rem] font-medium text-ink-800 shadow-lift"
    role="status"
  >
    <span class="flex items-center gap-2">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#25d366] opacity-75 motion-reduce:hidden"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-[#25d366]"></span>
      </span>
      {bubble}
    </span>
  </div>

  <button
    type="button"
    id="chat-button"
    class="chat-button group relative flex h-14 w-14 items-center justify-center rounded-full bg-brand-600 text-white shadow-lift transition-[transform,background-color] duration-300 [transition-timing-function:var(--ease-spring)] hover:scale-110 hover:bg-brand-700"
    aria-label={label}
    aria-haspopup="dialog"
  >
    <!-- halo animado -->
    <span class="chat-halo pointer-events-none absolute inset-0 rounded-full" aria-hidden="true"></span>
    <!-- icono chat: burbuja sólida, mismo peso visual que el de WhatsApp -->
    <svg class="chat-icon-chat absolute h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 3.5c-5 0-9 3.36-9 7.5 0 2.24 1.16 4.26 3 5.65V21l3.6-2.02c.77.17 1.57.27 2.4.27 5 0 9-3.36 9-7.5s-4-7.25-9-7.25Z" />
      <circle cx="8.3" cy="11" r="1.05" fill="var(--color-brand-600)" />
      <circle cx="12" cy="11" r="1.05" fill="var(--color-brand-600)" />
      <circle cx="15.7" cy="11" r="1.05" fill="var(--color-brand-600)" />
    </svg>
    <!-- icono cerrar -->
    <svg class="chat-icon-close absolute h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
      <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round" />
    </svg>
  </button>

  <span
    id="chat-tooltip"
    class="pointer-events-none absolute right-16 bottom-1.5 hidden whitespace-nowrap rounded-lg bg-ink-950 px-3.5 py-2 text-[0.8rem] font-semibold text-white opacity-0 shadow-lift transition-opacity duration-300 md:block"
    aria-hidden="true"
  >
    {label}
  </span>
</div>

<style>
  #chat-launcher {
    /* entrada */
    opacity: 0;
    transform: translateY(1.5rem) scale(0.8);
    animation: chat-enter 0.6s var(--ease-spring) forwards;
    animation-delay: 1.4s;
  }
  @keyframes chat-enter {
    to { opacity: 1; transform: none; }
  }

  /* Halo con pulso de atención (se detiene tras varias repeticiones) */
  .chat-halo {
    box-shadow: 0 0 0 0 rgb(41 147 170 / 0.5);
    animation: chat-pulse 2.4s var(--ease-out-expo) 3s 4;
  }
  @keyframes chat-pulse {
    0% { box-shadow: 0 0 0 0 rgb(41 147 170 / 0.5); }
    70% { box-shadow: 0 0 0 16px rgb(41 147 170 / 0); }
    100% { box-shadow: 0 0 0 0 rgb(41 147 170 / 0); }
  }

  /* Burbuja de saludo: aparece y se auto-oculta */
  .chat-bubble {
    opacity: 0;
    transform: translateY(0.5rem) scale(0.9);
    transition: opacity 0.4s var(--ease-out-expo), transform 0.4s var(--ease-out-expo);
  }
  #chat-launcher.greeting .chat-bubble {
    opacity: 1;
    transform: none;
  }

  /* Tooltip en hover (desktop) */
  #chat-button:hover ~ #chat-tooltip {
    opacity: 1;
  }

  /*
   * Morph entre el icono de chat y el de cerrar, usando `transform` (no las
   * propiedades scale/rotate independientes de Tailwind v4, que no son
   * canceladas por `transform: none`). Ambos estados viven en este único
   * bloque de estilo, sin clases de utilidad de Tailwind compitiendo.
   */
  .chat-icon-chat,
  .chat-icon-close {
    transition: transform 0.3s var(--ease-spring), opacity 0.25s ease;
  }
  .chat-icon-close {
    transform: scale(0) rotate(90deg);
    opacity: 0;
  }
  #chat-launcher[data-state='open'] .chat-icon-chat {
    transform: scale(0) rotate(-90deg);
    opacity: 0;
  }
  #chat-launcher[data-state='open'] .chat-icon-close {
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }
  #chat-launcher[data-state='open'] .chat-bubble {
    opacity: 0;
    transform: translateY(0.5rem) scale(0.9);
  }

  @media (prefers-reduced-motion: reduce) {
    #chat-launcher {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .chat-halo { animation: none; }
    .chat-button { transition: background-color 0.2s; }
  }
</style>

<script>
  import { ensureThirdParties } from '@/scripts/thirdparty';

  interface TawkAPI {
    toggle?: () => void;
  }
  const w = window as Window & { __cenipsaChatGlobals?: boolean };
  const tawk = () => (window as unknown as { Tawk_API?: TawkAPI }).Tawk_API;
  const launcher = () => document.getElementById('chat-launcher');

  // Estado compartido a nivel de módulo: el widget de Tawk es un singleton
  // real (persiste entre navegaciones con view transitions), así que su
  // estado de apertura pendiente/reintento también debe serlo — si viviera
  // dentro de initChatLauncher() cada navegación crearía un cierre nuevo con
  // su propio "pendingOpen", dejando temporizadores huérfanos apuntando a
  // botones de páginas ya no visibles (la causa de que el chat no abriera
  // de forma consistente al navegar, p. ej. a la versión en inglés).
  let pendingOpen = false;
  let fallbackTimer: number | undefined;

  function clearFallback() {
    if (fallbackTimer !== undefined) {
      window.clearTimeout(fallbackTimer);
      fallbackTimer = undefined;
    }
  }

  // Si Tawk está bloqueado (ad-blocker) o tarda demasiado en responder, no
  // dejamos el botón "colgado": abrimos WhatsApp como alternativa.
  function fallbackToWhatsApp() {
    pendingOpen = false;
    clearFallback();
    const whatsapp = launcher()?.dataset.whatsapp;
    if (whatsapp) window.open(whatsapp, '_blank', 'noopener');
  }

  function requestToggle() {
    const api = tawk();
    if (api?.toggle) {
      api.toggle();
    } else {
      pendingOpen = true;
      ensureThirdParties(); // dispara la carga de Tawk si aún no ocurrió
      clearFallback();
      fallbackTimer = window.setTimeout(fallbackToWhatsApp, 6000);
    }
  }

  // Listeners globales: registrados UNA sola vez para toda la sesión de
  // navegación (nunca se duplican entre astro:page-load), y siempre leen el
  // #chat-launcher VIGENTE en el momento del evento en lugar de cerrar sobre
  // una referencia capturada en una navegación anterior.
  if (!w.__cenipsaChatGlobals) {
    w.__cenipsaChatGlobals = true;
    document.addEventListener('tawk:ready', () => {
      clearFallback();
      if (pendingOpen) {
        pendingOpen = false;
        tawk()?.toggle?.();
      }
    });
    document.addEventListener('tawk:blocked', () => {
      if (pendingOpen) fallbackToWhatsApp();
    });
    document.addEventListener('tawk:maximized', () => {
      const root = launcher();
      if (root) root.dataset.state = 'open';
    });
    document.addEventListener('tawk:minimized', () => {
      const root = launcher();
      if (root) root.dataset.state = 'idle';
    });
  }

  function initChatLauncher() {
    const root = launcher();
    const button = document.getElementById('chat-button');
    if (!root || !button || button.dataset.bound === 'true') return;
    button.dataset.bound = 'true';
    button.addEventListener('click', requestToggle);

    // Saludo temporal (una vez por sesión), si no se abrió el chat.
    try {
      if (!sessionStorage.getItem('cenipsa-chat-greeted')) {
        window.setTimeout(() => root.classList.add('greeting'), 2600);
        window.setTimeout(() => root.classList.remove('greeting'), 9000);
        sessionStorage.setItem('cenipsa-chat-greeted', '1');
      }
    } catch {
      /* sin storage: omitir saludo persistente */
    }
    button.addEventListener('pointerenter', () => root.classList.remove('greeting'));
  }

  initChatLauncher();
  document.addEventListener('astro:page-load', initChatLauncher);
</script>
