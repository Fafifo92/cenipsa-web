---
/** Acordeón de preguntas frecuentes con <details>/<summary> nativos mejorados. */
export interface FaqItem {
  question: string;
  answer: string; // HTML permitido (contenido curado propio)
}
export interface Props {
  items: FaqItem[];
  /** Abre el primero por defecto */
  openFirst?: boolean;
}
const { items, openFirst = false } = Astro.props;
---

<div class="space-y-3.5">
  {
    items.map((item, i) => (
      <details
        class="faq-item group overflow-hidden rounded-2xl border border-ink-100 bg-white shadow-soft transition-shadow open:shadow-lift"
        open={openFirst && i === 0}
        data-reveal
        style={`--reveal-delay:${Math.min(i, 8) * 60}ms`}
      >
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-left font-semibold text-ink-950 transition-colors [&::-webkit-details-marker]:hidden group-open:text-brand-700 hover:text-brand-700">
          <span class="text-[1.02rem] leading-snug">{item.question}</span>
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-ink-200 transition-all duration-300 group-open:rotate-45 group-open:border-brand-500 group-open:bg-brand-50" aria-hidden="true">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M12 5v14M5 12h14" stroke-linecap="round" />
            </svg>
          </span>
        </summary>
        <div class="faq-answer px-6 pb-6 text-[0.98rem] leading-relaxed text-ink-700" set:html={item.answer} />
      </details>
    ))
  }
</div>

<style>
  .faq-answer :global(p + p) {
    margin-top: 0.75rem;
  }
  .faq-answer :global(a) {
    color: var(--color-brand-700);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .faq-answer :global(ul) {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .faq-answer :global(li + li) {
    margin-top: 0.4rem;
  }
</style>
