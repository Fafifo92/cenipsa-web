---
/**
 * Aviso (modal) que informa al usuario del sitio en inglés que los artículos
 * del blog están redactados en español. Se muestra una vez por sesión.
 * `esUrl` permite ofrecer el salto a la versión en español de la misma vista.
 */
export interface Props {
  esUrl: string;
}
const { esUrl } = Astro.props;
---

<div
  id="blog-es-notice"
  class="fixed inset-0 z-[80] hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="blog-notice-title"
  aria-describedby="blog-notice-desc"
  data-es-url={esUrl}
>
  <div class="notice-backdrop absolute inset-0 bg-ink-950/70 opacity-0 backdrop-blur-sm transition-opacity duration-300"></div>
  <div
    class="notice-card relative w-full max-w-md translate-y-3 rounded-3xl border border-ink-100 bg-white p-7 opacity-0 shadow-lift transition-all duration-300 [transition-timing-function:var(--ease-out-expo)] md:p-8"
  >
    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50 text-brand-700">
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M3 5h12M9 3v2m1.5 0c-.5 4.5-2.5 8-6.5 10M5 8c1.5 3.5 4 5.5 7 6.5M14 20l4-9 4 9m-6.5-2h5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>
    <h2 id="blog-notice-title" class="mt-5 font-display text-2xl font-semibold text-ink-950">
      Our blog is written in Spanish
    </h2>
    <p id="blog-notice-desc" class="mt-3 text-[0.95rem] leading-relaxed text-ink-600">
      Our editorial team publishes these articles in Spanish. You can keep browsing the site in English —
      only the blog content stays in its original language.
    </p>
    <div class="mt-7 flex flex-col gap-2.5 sm:flex-row">
      <button type="button" id="blog-notice-accept" class="btn-primary w-full">Got it, continue</button>
      <a href={esUrl} class="btn-outline w-full">Ver sitio en español</a>
    </div>
  </div>
</div>

<style>
  #blog-es-notice.is-open {
    display: flex;
  }
  #blog-es-notice.is-visible .notice-backdrop {
    opacity: 1;
  }
  #blog-es-notice.is-visible .notice-card {
    opacity: 1;
    translate: 0 0;
  }
</style>

<script>
  function initBlogNotice() {
    const modal = document.getElementById('blog-es-notice');
    if (!modal || modal.dataset.bound === 'true') return;
    modal.dataset.bound = 'true';

    const KEY = 'cenipsa-blog-es-notice';
    const accept = document.getElementById('blog-notice-accept');
    let lastFocus: HTMLElement | null = null;

    const close = () => {
      modal.classList.remove('is-visible');
      window.setTimeout(() => modal.classList.remove('is-open'), 300);
      try {
        sessionStorage.setItem(KEY, '1');
      } catch {
        /* modo privado sin storage: no persiste, aceptable */
      }
      lastFocus?.focus();
      document.removeEventListener('keydown', onKey);
    };

    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') close();
    };

    const open = () => {
      lastFocus = document.activeElement as HTMLElement;
      modal.classList.add('is-open');
      requestAnimationFrame(() => modal.classList.add('is-visible'));
      document.addEventListener('keydown', onKey);
      window.setTimeout(() => accept?.focus(), 60);
    };

    accept?.addEventListener('click', close);
    modal.querySelector('.notice-backdrop')?.addEventListener('click', close);

    let seen = false;
    try {
      seen = sessionStorage.getItem(KEY) === '1';
    } catch {
      seen = false;
    }
    if (!seen) window.setTimeout(open, 600);
  }

  initBlogNotice();
  document.addEventListener('astro:page-load', initBlogNotice);
</script>
