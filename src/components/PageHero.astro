---
/** Hero interior: fondo tinta con motivo de huella, eyebrow, H1 y descripción. */
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';

export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  crumbs?: Crumb[];
  lang?: 'es' | 'en';
  /** Foto de fondo (ruta pública) con velo azul. */
  image?: string;
}
const { eyebrow, title, description, crumbs, lang = 'es', image } = Astro.props;
---

<section class="relative overflow-hidden bg-ink-950 pt-36 pb-16 md:pt-44 md:pb-20">
  {image && <img src={image} alt="" width="1600" height="1067" fetchpriority="high" decoding="async" class="absolute inset-0 h-full w-full object-cover" />}
  {image && <div class="absolute inset-0 bg-gradient-to-r from-ink-950/90 via-ink-950/60 to-ink-950/20" aria-hidden="true"></div>}
  {!image && (<div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -top-40 right-[-10%] h-[30rem] w-[30rem] rounded-full bg-brand-500/10 blur-3xl"></div>
    <div class="absolute bottom-[-40%] left-[-5%] h-[26rem] w-[26rem] rounded-full bg-gold-500/8 blur-3xl"></div>
  </div>)}

  <div class="container-site relative">
    {crumbs && <Breadcrumbs crumbs={crumbs} onDark lang={lang} />}
    {eyebrow && <p class="eyebrow mt-7 text-brand-300" data-reveal><span class="h-px w-8 bg-gold-400" aria-hidden="true"></span>{eyebrow}</p>}
    <h1
      class="mt-4 max-w-3xl font-display text-4xl font-semibold leading-[1.12] text-white md:text-[3.2rem]"
      data-reveal
      style="--reveal-delay: 90ms"
    >
      {title}
    </h1>
    {
      description && (
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-200" data-reveal style="--reveal-delay: 180ms">
          {description}
        </p>
      )
    }
    <slot />
  </div>
</section>
