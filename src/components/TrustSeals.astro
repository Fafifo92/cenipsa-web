---
/**
 * Sellos de confianza verificables (home + footer): razón social y NIT, sede
 * física, afiliación a la CCB, pagos seguros y política de datos (Habeas Data).
 */
import Icon from './Icon.astro';
import { SITE } from '@/lib/site';

export interface Props {
  lang?: 'es' | 'en';
  /** dark: sobre fondo azul jurídico (footer) · light: sobre marfil/blanco. */
  tone?: 'dark' | 'light';
}
const { lang = 'es', tone = 'light' } = Astro.props;
const isEs = lang === 'es';

const seals = [
  {
    icon: 'building',
    title: SITE.legalName,
    text: `NIT ${SITE.nit}`,
    href: isEs ? '/nosotros/' : '/en/about-us/',
  },
  {
    icon: 'map-pin',
    title: isEs ? 'Sede Norte, Bogotá' : 'North office, Bogotá',
    text: 'Edificio Torre del Reloj · Cra. 62 # 103-44, Of. 403',
    href: isEs ? '/contacto/' : '/en/contact/',
  },
  {
    icon: 'landmark',
    img: '/images/sello-ccb-afiliados-2026.png',
    title: isEs ? 'Círculo de Afiliados CCB' : 'Bogotá Chamber of Commerce',
    text: isEs ? 'Cámara de Comercio de Bogotá' : 'Affiliates Circle member',
    href: isEs ? '/nosotros/#ccb-title' : '/en/about-us/',
  },
  {
    icon: 'shield',
    title: isEs ? 'Pagos seguros' : 'Secure payments',
    text: isEs ? 'Pasarela PayU' : 'PayU gateway',
    href: isEs ? '/pagos-en-linea/' : '/en/payments/',
  },
  {
    icon: 'eye',
    title: isEs ? 'Confidencialidad y datos' : 'Confidentiality & data',
    text: isEs ? 'Habeas Data · Ley 1581 de 2012' : 'Habeas Data · Law 1581 of 2012',
    href: '/politica-de-tratamiento-de-datos-y-privacidad/',
  },
];

const dark = tone === 'dark';
---

<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
  {
    seals.map((s) => (
      <li>
        <a
          href={s.href}
          class:list={[
            'group flex h-full min-w-0 items-start gap-3 rounded-xl border p-4 transition-colors duration-300',
            dark
              ? 'border-white/10 bg-white/[0.03] hover:border-gold-400/60'
              : 'border-ink-950/10 bg-white hover:border-gold-400',
          ]}
        >
          {s.img ? (
            <img src={s.img} width="254" height="254" alt="" loading="lazy" decoding="async" class="h-11 w-11 shrink-0" />
          ) : (
          <span
              class:list={[
                'flex h-9 w-9 shrink-0 items-center justify-center rounded-lg',
                dark ? 'bg-gold-400/10 text-gold-400' : 'bg-ink-950 text-gold-400',
              ]}
            >
              <Icon name={s.icon} class="h-4.5 w-4.5" />
            </span>
          )}
          <span class="min-w-0">
            <span class:list={['block text-[0.86rem] leading-snug font-semibold', dark ? 'text-white' : 'text-ink-950']}>{s.title}</span>
            <span class:list={['mt-0.5 block text-[0.78rem] leading-snug', dark ? 'text-ink-300' : 'text-ink-600']}>{s.text}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
