---
/** Footer oscuro con columnas de navegación, contacto, redes y legales. */
import Logo from './Logo.astro';
import { SITE, CONTACT, SOCIAL, FOOTER_SEO_LINKS, FOOTER_SERVICES } from '@/lib/site';

export interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;
const year = new Date().getFullYear();

const t =
  lang === 'es'
    ? {
        about: 'Nosotros',
        services: 'Nuestros servicios',
        links: 'Enlaces de interés',
        contact: 'Contacto',
        blurb:
          'Contamos con amplia trayectoria en el campo de las investigaciones privadas y el derecho en Colombia.',
        who: 'Quiénes somos',
        blog: 'Blog',
        faqs: 'Preguntas frecuentes',
        terms: 'Términos y condiciones',
        privacy: 'Política de tratamiento de datos',
        team: 'Equipo interdisciplinar',
        guarantees: 'Garantías',
        cases: 'Casos de éxito',
        rights: 'Todos los derechos reservados.',
        affiliation: 'Empresa afiliada al Círculo de Afiliados de la Cámara de Comercio de Bogotá.',
      }
    : {
        about: 'About us',
        services: 'Our services',
        links: 'Links of interest',
        contact: 'Contact',
        blurb: 'Extensive experience in private investigation and law across Colombia.',
        who: 'Who we are',
        blog: 'Blog',
        faqs: 'FAQ',
        terms: 'Terms and conditions',
        privacy: 'Data processing policy',
        team: 'Interdisciplinary team',
        guarantees: 'Guarantees',
        cases: 'Success stories',
        rights: 'All rights reserved.',
        affiliation: 'Member of the Bogotá Chamber of Commerce Affiliates Circle.',
      };

const aboutLinks =
  lang === 'es'
    ? [
        { label: t.who, href: '/nosotros/' },
        { label: t.team, href: '/equipo-interdisciplinar/' },
        { label: t.guarantees, href: '/garantias/' },
        { label: t.cases, href: '/casos-de-exito/' },
        { label: t.blog, href: '/blog/' },
        { label: t.faqs, href: '/faq/' },
      ]
    : [
        { label: t.who, href: '/en/about-us/' },
        { label: t.blog, href: '/blog/' },
        { label: t.faqs, href: '/en/faq/' },
      ];

const socials = [
  {
    name: 'Facebook',
    href: SOCIAL.facebook,
    path: 'M14 13.5h2.5l1-4H14v-2c0-1 .5-2 2-2h1.5V2.14c-.3-.04-1.3-.14-2.5-.14C12.5 2 11 3.66 11 6.7v2.8H8v4h3V22h3v-8.5Z',
  },
  {
    name: 'Instagram',
    href: SOCIAL.instagram,
    path: 'M12 2c2.7 0 3 .01 4.1.06 1.1.05 1.8.22 2.5.47.7.26 1.2.6 1.8 1.15.6.56.9 1.12 1.2 1.8.2.65.4 1.4.4 2.46.1 1.07.1 1.41.1 4.13s0 3.06-.1 4.12c0 1.07-.2 1.8-.4 2.45a4.9 4.9 0 0 1-1.2 1.8 4.9 4.9 0 0 1-1.8 1.16c-.7.25-1.4.42-2.5.47-1.1.05-1.4.06-4.1.06s-3-.01-4.1-.06a7.4 7.4 0 0 1-2.5-.47 4.9 4.9 0 0 1-1.8-1.15 4.9 4.9 0 0 1-1.2-1.8 7.4 7.4 0 0 1-.4-2.46C2 15.06 2 14.72 2 12s0-3.06.1-4.12c0-1.07.2-1.8.4-2.45.3-.68.6-1.25 1.2-1.8a4.9 4.9 0 0 1 1.8-1.16c.7-.25 1.4-.42 2.5-.47C9 2 9.3 2 12 2Zm0 1.8c-2.7 0-3 .01-4 .06-1 .04-1.5.2-1.9.34-.5.19-.8.4-1.2.78-.4.38-.6.74-.8 1.21-.1.36-.3.9-.3 1.9-.1 1.05-.1 1.36-.1 4.01s0 2.96.1 4c0 1 .2 1.55.3 1.91.2.47.4.83.8 1.2.4.38.7.6 1.2.79.4.14.9.3 1.9.34 1 .05 1.3.06 4 .06s3-.01 4-.06c1-.04 1.5-.2 1.9-.34.5-.19.8-.41 1.2-.79.4-.37.6-.73.8-1.2.1-.36.3-.9.3-1.9.1-1.05.1-1.36.1-4.01s0-2.96-.1-4c0-1-.2-1.55-.3-1.91a3.1 3.1 0 0 0-.8-1.2 3.1 3.1 0 0 0-1.2-.79c-.4-.14-.9-.3-1.9-.34-1-.05-1.3-.06-4-.06Zm0 3.06a5.14 5.14 0 1 1 0 10.28 5.14 5.14 0 0 1 0-10.28Zm0 8.48a3.34 3.34 0 1 0 0-6.68 3.34 3.34 0 0 0 0 6.68Zm6.54-8.7a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0Z',
  },
  {
    name: 'LinkedIn',
    href: SOCIAL.linkedin,
    path: 'M6.94 5a2 2 0 1 1-4-.03 2 2 0 0 1 4 .03ZM7 8.48H3V21h4V8.48Zm6.32 0H9.34V21h3.94v-6.57c0-3.66 4.77-4 4.77 0V21H22v-7.93c0-6.17-7.06-5.94-8.72-2.91l.04-1.68Z',
  },
];
---

<footer class="relative overflow-hidden bg-ink-950 text-ink-200">
  <!-- Motivo decorativo -->
  <div class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-brand-500/5 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-32 -left-24 h-96 w-96 rounded-full bg-gold-500/5 blur-3xl" aria-hidden="true"></div>

  <div class="container-site relative section-pad">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr_1.2fr_1.2fr]">
      <!-- Marca -->
      <div>
        <a href={lang === 'es' ? '/' : '/en/'} aria-label="CENIPSA — Inteligencia Investigativa">
          <Logo variant="light" />
        </a>
        <p class="mt-5 max-w-xs text-[0.92rem] leading-relaxed text-ink-300">{t.blurb}</p>
        <p class="mt-4 max-w-xs text-[0.8rem] leading-relaxed text-ink-400">{t.affiliation}</p>
        <div class="mt-6 flex gap-3">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              class="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 text-ink-200 transition-all duration-300 hover:-translate-y-1 hover:border-brand-400 hover:text-brand-300"
              aria-label={s.name}
            >
              <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={s.path} />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Nosotros -->
      <nav aria-label={t.about}>
        <h2 class="font-display text-[0.95rem] font-semibold tracking-wide text-white">{t.about}</h2>
        <ul class="mt-5 space-y-2.5 text-[0.9rem]">
          {aboutLinks.map((l) => (
            <li>
              <a href={l.href} class="text-ink-300 transition-colors hover:text-brand-300">{l.label}</a>
            </li>
          ))}
          <li>
            <a href="/terminos-y-condiciones/" class="text-ink-300 transition-colors hover:text-brand-300">{t.terms}</a>
          </li>
          <li>
            <a href="/politica-de-tratamiento-de-datos-y-privacidad/" class="text-ink-300 transition-colors hover:text-brand-300">{t.privacy}</a>
          </li>
        </ul>
      </nav>

      <!-- Servicios + Enlaces de interés -->
      <nav aria-label={t.services}>
        <h2 class="font-display text-[0.95rem] font-semibold tracking-wide text-white">{t.services}</h2>
        <ul class="mt-5 space-y-2.5 text-[0.9rem]">
          {FOOTER_SERVICES.map((l) => (
            <li>
              <a href={l.href} class="text-ink-300 transition-colors hover:text-brand-300">{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="space-y-10">
        <nav aria-label={t.links}>
          <h2 class="font-display text-[0.95rem] font-semibold tracking-wide text-white">{t.links}</h2>
          <ul class="mt-5 columns-1 space-y-2.5 text-[0.9rem]">
            {FOOTER_SEO_LINKS.slice(0, 8).map((l) => (
              <li>
                <a href={l.href} class="text-ink-300 transition-colors hover:text-brand-300">{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>

    <!-- Más enlaces de interés (fila completa) -->
    <nav class="mt-10 border-t border-white/10 pt-8" aria-label={`${t.links} 2`}>
      <ul class="flex flex-wrap gap-x-7 gap-y-2.5 text-[0.85rem]">
        {FOOTER_SEO_LINKS.slice(8).map((l) => (
          <li>
            <a href={l.href} class="text-ink-400 transition-colors hover:text-brand-300">{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Contacto -->
    <div class="mt-10 grid gap-6 border-t border-white/10 pt-8 text-[0.9rem] sm:grid-cols-2 lg:grid-cols-4">
      <p class="flex items-start gap-3">
        <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2a7.5 7.5 0 0 0-7.5 7.5c0 5.25 7.5 12.5 7.5 12.5s7.5-7.25 7.5-12.5A7.5 7.5 0 0 0 12 2Zm0 10a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z" />
        </svg>
        <span>{CONTACT.address.street}, {CONTACT.address.city}, {CONTACT.address.countryName}</span>
      </p>
      <p class="flex flex-col gap-2">
        <a href={CONTACT.pbxHref} class="transition-colors hover:text-brand-300">PBX {CONTACT.pbx}</a>
        <a href={CONTACT.whatsappHref} target="_blank" rel="noopener" class="transition-colors hover:text-brand-300">
          WhatsApp {CONTACT.whatsapp}
        </a>
      </p>
      <p class="flex flex-col gap-2">
        <a href={`mailto:${CONTACT.emailInfo}`} class="break-all transition-colors hover:text-brand-300">{CONTACT.emailInfo}</a>
        <a href={`mailto:${CONTACT.emailGerencia}`} class="break-all transition-colors hover:text-brand-300">{CONTACT.emailGerencia}</a>
      </p>
      <p class="text-ink-400">
        {lang === 'es' ? 'Pagos seguros en línea con' : 'Secure online payments with'}
        <a href="/pagos-en-linea/" class="font-semibold text-white transition-colors hover:text-brand-300">PayU</a>
      </p>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-white/10 pt-6 text-[0.8rem] text-ink-500 sm:flex-row">
      <p>© {year} {SITE.legalName} — {SITE.name}. {t.rights}</p>
      <p>Bogotá · Medellín · Cali · Colombia</p>
    </div>
  </div>
</footer>
