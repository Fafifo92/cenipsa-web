---
/** Footer corporativo: marca, la firma, soluciones (pilares), legal, contacto y sellos de confianza. */
import Logo from './Logo.astro';
import TrustSeals from './TrustSeals.astro';
import { SITE, CONTACT, SOCIAL } from '@/lib/site';
import { PILLARS_ES, PILLARS_EN } from '@/lib/pillars';

export interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;
const year = new Date().getFullYear();

const isEs = lang === 'es';

const t = isEs
  ? {
      firm: 'La firma',
      solutions: 'Soluciones',
      legal: 'Legal y confianza',
      blurb: 'Firma de inteligencia forense e investigación jurídica. Convertimos hechos complejos en evidencia útil y decisiones jurídicas claras.',
      rights: 'Todos los derechos reservados.',
      seals: 'Sellos de confianza',
    }
  : {
      firm: 'The firm',
      solutions: 'Solutions',
      legal: 'Legal & trust',
      blurb: 'Forensic intelligence and legal investigation firm. We turn complex facts into useful evidence and clear legal decisions.',
      rights: 'All rights reserved.',
      seals: 'Trust seals',
    };

const firmLinks = isEs
  ? [
      { label: 'Quiénes somos', href: '/nosotros/' },
      { label: 'Equipo interdisciplinar', href: '/equipo-interdisciplinar/' },
      { label: 'Garantías de servicio', href: '/garantias/' },
      { label: 'Cómo trabajamos', href: '/como-trabajamos/' },
      { label: 'Blog', href: '/blog/' },
      { label: 'Preguntas frecuentes', href: '/faq/' },
      { label: 'Contacto', href: '/contacto/' },
    ]
  : [
      { label: 'Who we are', href: '/en/about-us/' },
      { label: 'Interdisciplinary team', href: '/en/interdisciplinary-team/' },
      { label: 'Guarantees', href: '/en/guarantees/' },
      { label: 'How we work', href: '/en/how-we-work/' },
      { label: 'Blog', href: '/en/blog/' },
      { label: 'FAQ', href: '/en/faq/' },
      { label: 'Contact', href: '/en/contact/' },
    ];

const pillars = isEs ? PILLARS_ES : PILLARS_EN;
const servicesPath = isEs ? '/servicios/' : '/en/services/';
const solutionLinks = [
  ...pillars.map((p) => ({ label: p.name, href: `${servicesPath}#${p.id}` })),
  ...(isEs
    ? [
        { label: 'Asesoría jurídica y litigio', href: '/asesoria-juridica/' },
        { label: 'Servicios para abogados', href: '/servicios-especiales/' },
        { label: 'Ciberseguridad e informática forense', href: '/ciberseguridad-e-informatica-forense/' },
      ]
    : [
        { label: 'Legal advice & litigation', href: '/en/legal-advice/' },
        { label: 'Services for lawyers', href: '/en/services-for-lawyers/' },
        { label: 'Cybersecurity & digital forensics', href: '/en/cybersecurity-digital-forensics/' },
      ]),
];

// Legales: solo existen en español; en EN se enlazan igual (texto jurídico primario).
const legalLinks = [
  { label: isEs ? 'Términos y condiciones' : 'Terms and conditions', href: '/terminos-y-condiciones/' },
  { label: isEs ? 'Política de tratamiento de datos (Habeas Data)' : 'Data processing policy (Habeas Data)', href: '/politica-de-tratamiento-de-datos-y-privacidad/' },
  { label: isEs ? 'Pagos seguros en línea' : 'Secure online payments', href: isEs ? '/pagos-en-linea/' : '/en/payments/' },
];

const socials = [
  {
    name: 'Facebook',
    href: SOCIAL.facebook,
    path: 'M14 13.5h2.5l1-4H14v-2c0-1 .5-2 2-2h1.5V2.14c-.3-.04-1.3-.14-2.5-.14C12.5 2 11 3.66 11 6.7v2.8H8v4h3V22h3v-8.5Z',
  },
  {
    name: 'Instagram',
    href: SOCIAL.instagram,
    path: 'M12 2c2.7 0 3 .01 4.1.06 1.1.05 1.8.22 2.5.47.7.26 1.2.6 1.8 1.15.6.56.9 1.12 1.2 1.8.2.65.4 1.4.4 2.46.1 1.07.1 1.41.1 4.13s0 3.06-.1 4.12c0 1.07-.2 1.8-.4 2.45a4.9 4.9 0 0 1-1.2 1.8 4.9 4.9 0 0 1-1.8 1.16c-.7.25-1.4.42-2.5.47-1.1.05-1.4.06-4.1.06s-3-.01-4.1-.06a7.4 7.4 0 0 1-2.5-.47 4.9 4.9 0 0 1-1.8-1.15 4.9 4.9 0 0 1-1.2-1.8 7.4 7.4 0 0 1-.4-2.46C2 15.06 2 14.72 2 12s0-3.06.1-4.12c0-1.07.2-1.8.4-2.45.3-.68.6-1.25 1.2-1.8a4.9 4.9 0 0 1 1.8-1.16c.7-.25 1.4-.42 2.5-.47C9 2 9.3 2 12 2Zm0 1.8c-2.7 0-3 .01-4 .06-1 .04-1.5.2-1.9.34-.5.19-.8.4-1.2.78-.4.38-.6.74-.8 1.21-.1.36-.3.9-.3 1.9-.1 1.05-.1 1.36-.1 4.01s0 2.96.1 4c0 1 .2 1.55.3 1.91.2.47.4.83.8 1.2.4.38.7.6 1.2.79.4.14.9.3 1.9.34 1 .05 1.3.06 4 .06s3-.01 4-.06c1-.04 1.5-.2 1.9-.34.5-.19.8-.41 1.2-.79.4-.37.6-.73.8-1.2.1-.36.3-.9.3-1.9.1-1.05.1-1.36.1-4.01s0-2.96-.1-4c0-1-.2-1.55-.3-1.91a3.1 3.1 0 0 0-.8-1.2 3.1 3.1 0 0 0-1.2-.79c-.4-.14-.9-.3-1.9-.34-1-.05-1.3-.06-4-.06Zm0 3.06a5.14 5.14 0 1 1 0 10.28 5.14 5.14 0 0 1 0-10.28Zm0 8.48a3.34 3.34 0 1 0 0-6.68 3.34 3.34 0 0 0 0 6.68Zm6.54-8.7a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0Z',
  },
  {
    name: 'LinkedIn',
    href: SOCIAL.linkedin,
    path: 'M6.94 5a2 2 0 1 1-4-.03 2 2 0 0 1 4 .03ZM7 8.48H3V21h4V8.48Zm6.32 0H9.34V21h3.94v-6.57c0-3.66 4.77-4 4.77 0V21H22v-7.93c0-6.17-7.06-5.94-8.72-2.91l.04-1.68Z',
  },
];
---

<footer class="relative overflow-hidden bg-ink-950 text-ink-200">
  <!-- Motivo decorativo -->
  <div class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-brand-500/5 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-32 -left-24 h-96 w-96 rounded-full bg-gold-500/5 blur-3xl" aria-hidden="true"></div>

  <div class="container-site relative section-pad">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
      <!-- Marca -->
      <div>
        <a href={isEs ? '/' : '/en/'} aria-label={`${SITE.brand} — ${isEs ? SITE.descriptor : SITE.descriptorEn}`}>
          <Logo variant="light" full class="h-20 md:h-24" />
        </a>
        <p class="mt-5 max-w-xs text-[0.92rem] leading-relaxed text-ink-300">{t.blurb}</p>
        <p class="mt-3 max-w-xs font-display text-[0.95rem] text-gold-400 italic">{isEs ? SITE.tagline : SITE.taglineEn}</p>
        <div class="mt-6 flex gap-3">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              class="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 text-white transition-all duration-300 hover:-translate-y-1 hover:border-gold-400 hover:text-gold-300"
              aria-label={s.name}
            >
              <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={s.path} />
              </svg>
            </a>
          ))}
        </div>
      </div>

      {[
        { title: t.firm, links: firmLinks },
        { title: t.solutions, links: solutionLinks },
        { title: t.legal, links: legalLinks },
      ].map((col) => (
        <nav aria-label={col.title}>
          <h2 class="font-display text-[0.95rem] font-semibold tracking-wide text-white">{col.title}</h2>
          <ul class="mt-5 space-y-2.5 text-[0.9rem]">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="text-ink-300 transition-colors hover:text-gold-300">{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <!-- Sellos de confianza -->
    <div class="mt-12 border-t border-white/10 pt-8">
      <h2 class="sr-only">{t.seals}</h2>
      <TrustSeals lang={lang} tone="dark" />
    </div>

    <!-- Contacto -->
    <div class="mt-10 grid gap-6 border-t border-white/10 pt-8 text-[0.9rem] sm:grid-cols-2 lg:grid-cols-3">
      <p class="flex items-start gap-3">
        <svg class="mt-0.5 h-4 w-4 shrink-0 text-gold-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2a7.5 7.5 0 0 0-7.5 7.5c0 5.25 7.5 12.5 7.5 12.5s7.5-7.25 7.5-12.5A7.5 7.5 0 0 0 12 2Zm0 10a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z" />
        </svg>
        <span>{CONTACT.address.street}, {CONTACT.address.city}, {CONTACT.address.countryName}</span>
      </p>
      <p class="flex flex-col gap-2">
        <a href={CONTACT.pbxHref} class="transition-colors hover:text-gold-300">PBX {CONTACT.pbx}</a>
        <a href={CONTACT.whatsappHref} target="_blank" rel="noopener" class="transition-colors hover:text-gold-300">
          WhatsApp {CONTACT.whatsapp}
        </a>
      </p>
      <p class="flex flex-col gap-2">
        <a href={`mailto:${CONTACT.emailInfo}`} class="break-all transition-colors hover:text-gold-300">{CONTACT.emailInfo}</a>
        <a href={`mailto:${CONTACT.emailGerencia}`} class="break-all transition-colors hover:text-gold-300">{CONTACT.emailGerencia}</a>
      </p>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-white/10 pt-6 text-[0.8rem] text-ink-400 sm:flex-row">
      <p>© {year} {SITE.legalName} · NIT {SITE.nit}. {t.rights}</p>
      <p>Bogotá · Medellín · Cali · Colombia</p>
    </div>
  </div>
</footer>
