---
/**
 * Capa decorativa animada: trazas de conexión entre nodos (ciudades) con
 * pulsos de luz que viajan por los arcos. Para cabeceras con foto
 * tecnológica (Contacto). Respeta prefers-reduced-motion.
 */
const nodes = [
  { x: 170, y: 250 }, // Bogotá (origen)
  { x: 330, y: 120 },
  { x: 520, y: 170 },
  { x: 690, y: 95 },
  { x: 860, y: 210 },
  { x: 610, y: 330 },
  { x: 410, y: 300 },
];
const arcs = [
  [0, 1], [0, 2], [0, 6], [1, 3], [2, 4], [6, 5], [5, 4], [2, 3],
].map(([a, b], i) => {
  const p = nodes[a];
  const q = nodes[b];
  const mx = (p.x + q.x) / 2;
  const my = Math.min(p.y, q.y) - 70;
  return { d: `M${p.x},${p.y} Q${mx},${my} ${q.x},${q.y}`, i };
});
---

<svg class="network-overlay pointer-events-none absolute inset-0 h-full w-full" viewBox="0 0 1000 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <linearGradient id="arcGrad" x1="0" x2="1">
      <stop offset="0" stop-color="#c9a536" stop-opacity="0.15" />
      <stop offset="0.5" stop-color="#e8d799" stop-opacity="0.9" />
      <stop offset="1" stop-color="#c9a536" stop-opacity="0.15" />
    </linearGradient>
  </defs>
  {
    arcs.map((a) => (
      <g>
        <path d={a.d} class="arc" pathLength="100" style={`--i:${a.i}`} />
        <circle r="3.2" class="spark">
          <animateMotion dur={`${4 + (a.i % 3)}s`} begin={`${a.i * 0.45}s`} repeatCount="indefinite" path={a.d} />
        </circle>
      </g>
    ))
  }
  {
    nodes.map((n, i) => (
      <g>
        <circle cx={n.x} cy={n.y} r={i === 0 ? 7 : 4.5} class={i === 0 ? 'node node--origin' : 'node'} />
        <circle cx={n.x} cy={n.y} r={i === 0 ? 7 : 4.5} class="ping" style={`--i:${i}`} />
      </g>
    ))
  }
</svg>

<style>
  .network-overlay {
    /* Se desvanece bajo el texto del hero (izquierda) para no restar legibilidad. */
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgb(0 0 0 / 0.25) 30%, black 58%);
    mask-image: linear-gradient(90deg, transparent 0%, rgb(0 0 0 / 0.25) 30%, black 58%);
  }
  .arc {
    fill: none;
    stroke: url(#arcGrad);
    stroke-width: 1.4;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: draw 2.2s var(--ease-out-expo) forwards;
    animation-delay: calc(var(--i) * 0.18s + 0.3s);
  }
  .spark {
    fill: #f4ecc6;
    filter: drop-shadow(0 0 4px #c9a536);
  }
  .node {
    fill: #c9a536;
  }
  .node--origin {
    fill: #f4ecc6;
  }
  .ping {
    fill: none;
    stroke: #c9a536;
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    animation: ping 2.6s ease-out infinite;
    animation-delay: calc(var(--i) * 0.35s);
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes ping {
    0% {
      transform: scale(1);
      opacity: 0.9;
    }
    100% {
      transform: scale(4);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .arc {
      animation: none;
      stroke-dashoffset: 0;
    }
    .ping,
    .spark {
      display: none;
    }
  }
</style>
