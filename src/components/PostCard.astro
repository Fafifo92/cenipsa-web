---
/** Tarjeta de entrada del blog: tema, tiempo de lectura y microinteracciones. */
import type { CollectionEntry } from 'astro:content';
import { BLOG_TOPICS, postTopic, readingMinutes } from '@/lib/blog';

export interface Props {
  post: CollectionEntry<'blog'>;
  index?: number;
  lang?: 'es' | 'en';
  /** Tarjeta grande (artículo destacado). */
  featured?: boolean;
}
const { post, index = 0, lang = 'es', featured = false } = Astro.props;
const href = `${lang === 'es' ? '/blog/' : '/en/blog/'}${post.id}/`;
const date = post.data.pubDate.toLocaleDateString(lang === 'es' ? 'es-CO' : 'en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const topic = postTopic(post);
const topicLabel = BLOG_TOPICS[lang].find((t) => t.id === topic)?.label ?? '';
const minutes = readingMinutes(post);
const t = lang === 'es' ? { read: 'Leer artículo', min: 'min de lectura' } : { read: 'Read article', min: 'min read' };
---

<article
  class:list={['post-card group relative flex h-full flex-col overflow-hidden rounded-2xl border border-ink-950/8 bg-white shadow-soft transition-all duration-500 hover:-translate-y-1.5 hover:border-gold-400/60 hover:shadow-lift', featured && 'lg:flex-row']}
  data-reveal
  data-topic={topic}
  data-title={post.data.title.toLowerCase()}
  style={`--reveal-delay:${(index % 3) * 90}ms`}
>
  <span class="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-gradient-to-r from-gold-400 to-brand-500 transition-transform duration-500 [transition-timing-function:var(--ease-out-expo)] group-hover:scale-x-100" aria-hidden="true"></span>
  <a href={href} class:list={['flex h-full flex-col', featured && 'lg:flex-row lg:items-stretch']}>
    {
      post.data.image && (
        <div class:list={['relative overflow-hidden bg-mist', featured ? 'aspect-[16/9] lg:aspect-auto lg:w-1/2' : 'aspect-[16/9]']}>
          <img
            src={post.data.image}
            alt={post.data.imageAlt ?? ''}
            width="640"
            height="360"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-700 [transition-timing-function:var(--ease-out-expo)] group-hover:scale-105"
          />
        </div>
      )
    }
    <div class:list={['flex flex-1 flex-col', featured ? 'p-7 md:p-9' : 'p-6']}>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-[0.75rem] font-semibold tracking-wide text-ink-500 uppercase">
        <span class="rounded-full bg-brand-50 px-2.5 py-1 text-brand-700 normal-case tracking-normal">{topicLabel}</span>
        <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{date}</time>
        <span class="inline-flex items-center gap-1 whitespace-nowrap">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" stroke-linecap="round" /></svg>
          {minutes} {t.min}
        </span>
      </p>
      <h2 class:list={['mt-3 font-display leading-snug font-semibold text-ink-950 transition-colors group-hover:text-brand-700', featured ? 'text-2xl md:text-[1.75rem]' : 'text-[1.2rem]']}>
        {post.data.title}
      </h2>
      <p class:list={['mt-3 flex-1 leading-relaxed text-ink-600', featured ? 'line-clamp-4 text-[0.98rem]' : 'line-clamp-3 text-[0.92rem]']}>
        {post.data.description}
      </p>
      <p class="mt-5 inline-flex items-center gap-2 text-[0.85rem] font-bold text-brand-700">
        {t.read}
        <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </p>
    </div>
  </a>
</article>
