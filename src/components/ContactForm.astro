---
/**
 * Formulario de contacto estático: POST al endpoint configurado
 * (PUBLIC_FORM_ENDPOINT, p. ej. Formspree) con honeypot antispam, reCAPTCHA v3
 * invisible (si hay PUBLIC_RECAPTCHA_SITE_KEY) y validación nativa.
 * Sin endpoint, degrada a mailto: prellenado.
 */
import { THIRD_PARTY, CONTACT, FORM_OPTIONS } from '@/lib/site';

export interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;
const hasEndpoint = Boolean(THIRD_PARTY.formEndpoint);
const recaptchaKey = THIRD_PARTY.recaptchaSiteKey;
const options = FORM_OPTIONS[lang];

const t =
  lang === 'es'
    ? {
        name: 'Nombre',
        email: 'Correo electrónico',
        phone: 'Teléfono (opcional)',
        type: 'Tipo de requerimiento',
        phase: 'Fase requerida',
        placeholder: 'Selecciona…',
        message: 'Describe brevemente el tipo de situación',
        messageHelp:
          'No incluyas documentos, contraseñas, información financiera ni datos sensibles de terceros. Te pediremos lo necesario de forma segura si el caso avanza.',
        noRelationship:
          'El envío de este formulario no crea una relación abogado-cliente ni de prestación de servicios; esta inicia solo cuando se acuerda formalmente el alcance.',
        privacy: 'He leído y acepto la',
        privacyLink: 'política de tratamiento de datos y privacidad',
        submit: 'Solicitar valoración confidencial',
        sending: 'Enviando…',
        note: 'Tus datos se tratan con absoluta confidencialidad.',
        error: 'No pudimos enviar el mensaje. Intenta de nuevo o escríbenos por WhatsApp.',
        recaptcha: 'Protegido por reCAPTCHA. Aplican la',
        privacyG: 'Política de privacidad',
        and: 'y las',
        termsG: 'Condiciones del servicio',
        ofGoogle: 'de Google.',
      }
    : {
        name: 'Name',
        email: 'Email',
        phone: 'Phone (optional)',
        type: 'Type of request',
        phase: 'Required phase',
        placeholder: 'Select…',
        message: 'Briefly describe the type of situation',
        messageHelp:
          'Do not include documents, passwords, financial information or sensitive data about third parties. We will request what is needed securely if the case moves forward.',
        noRelationship:
          'Submitting this form does not create an attorney-client or service relationship; that begins only once the scope is formally agreed.',
        privacy: 'I have read and accept the',
        privacyLink: 'data processing and privacy policy',
        submit: 'Request a confidential assessment',
        sending: 'Sending…',
        note: 'Your information is handled with absolute confidentiality.',
        error: 'We could not send your message. Please try again or reach us on WhatsApp.',
        recaptcha: 'Protected by reCAPTCHA. The Google',
        privacyG: 'Privacy Policy',
        and: 'and',
        termsG: 'Terms of Service',
        ofGoogle: 'apply.',
      };
const privacyHref = lang === 'es' ? '/politica-de-tratamiento-de-datos-y-privacidad/' : '/politica-de-tratamiento-de-datos-y-privacidad/';
---

<form
  id="contact-form"
  method="POST"
  action={hasEndpoint ? THIRD_PARTY.formEndpoint : '#'}
  class="space-y-5"
  data-endpoint={hasEndpoint ? 'true' : 'false'}
  data-mailto={CONTACT.emailInfo}
  data-thanks={lang === 'es' ? '/gracias/' : '/en/thank-you/'}
  data-recaptcha={recaptchaKey}
  data-error={t.error}
>
  <!-- honeypot: los bots lo rellenan, los humanos no lo ven -->
  <p class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
    <label>
      No llenar este campo
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="cf-name" class="field-label">{t.name} *</label>
      <input id="cf-name" name="name" type="text" required autocomplete="name" maxlength="120" class="field" />
    </div>
    <div>
      <label for="cf-email" class="field-label">{t.email} *</label>
      <input id="cf-email" name="email" type="email" required autocomplete="email" maxlength="150" class="field" />
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="cf-type" class="field-label">{t.type} *</label>
      <select id="cf-type" name="tipo" required class="field field-select">
        <option value="">{t.placeholder}</option>
        {options.type.map((o) => <option value={o}>{o}</option>)}
      </select>
    </div>
    <div>
      <label for="cf-phase" class="field-label">{t.phase}</label>
      <select id="cf-phase" name="fase" class="field field-select">
        <option value="">{t.placeholder}</option>
        {options.phase.map((o) => <option value={o}>{o}</option>)}
      </select>
    </div>
  </div>

  <div class="sm:w-1/2 sm:pr-2.5">
    <label for="cf-phone" class="field-label">{t.phone}</label>
    <input id="cf-phone" name="phone" type="tel" autocomplete="tel" maxlength="30" class="field" />
  </div>

  <div>
    <label for="cf-message" class="field-label">{t.message} *</label>
    <textarea id="cf-message" name="message" required rows="4" maxlength="1500" aria-describedby="cf-message-help" class="field resize-y"></textarea>
    <p id="cf-message-help" class="mt-1.5 text-[0.8rem] leading-relaxed text-ink-600">{t.messageHelp}</p>
  </div>

  <div class="flex items-start gap-3">
    <input id="cf-privacy" name="privacy" type="checkbox" required class="field-checkbox" />
    <label for="cf-privacy" class="text-[0.85rem] leading-relaxed text-ink-700">
      {t.privacy}
      <a href={privacyHref} class="font-medium text-brand-700 underline underline-offset-2" target="_blank" rel="noopener">
        {t.privacyLink}
      </a>. *
    </label>
  </div>

  <button type="submit" class="btn-primary w-full sm:w-auto" data-label={t.submit} data-sending={t.sending}>
    {t.submit}
  </button>
  <p class="text-[0.8rem] text-ink-600">{t.note}</p>
  <p class="text-[0.78rem] leading-relaxed text-ink-500">{t.noRelationship}</p>

  {
    recaptchaKey && (
      <p class="text-[0.72rem] leading-relaxed text-ink-400">
        {t.recaptcha}{' '}
        <a href="https://policies.google.com/privacy" target="_blank" rel="noopener" class="underline hover:text-ink-600">{t.privacyG}</a>{' '}
        {t.and}{' '}
        <a href="https://policies.google.com/terms" target="_blank" rel="noopener" class="underline hover:text-ink-600">{t.termsG}</a>{' '}
        {t.ofGoogle}
      </p>
    )
  }
</form>

<script>
  import '@/scripts/contact-form';
</script>
