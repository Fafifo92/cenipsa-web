---
/**
 * Gráfico «Ruta metodológica de contratación» (6 pasos).
 * - variant="timeline": línea de tiempo resumida para la home (6 hitos
 *   conectados en escritorio, vertical en móvil).
 * - variant="cards": tarjetas completas con viñetas (página «Antes de la
 *   Contratación»), pasos 1–3 y 4–6 en dos columnas, el 6 destacado como opcional.
 */
import { ROUTE_ES, ROUTE_EN } from '@/lib/route';

export interface Props {
  lang?: 'es' | 'en';
  variant?: 'timeline' | 'cards';
}
const { lang = 'es', variant = 'timeline' } = Astro.props;
const isEs = lang === 'es';
const steps = isEs ? ROUTE_ES : ROUTE_EN;
const t = isEs
  ? { step: 'Paso', optional: 'Opcional', of: 'de', more: 'Ver detalle', anchor: 'paso', page: '/antes-de-la-contratacion/' }
  : { step: 'Step', optional: 'Optional', of: 'of', more: 'See details', anchor: 'step', page: '/en/before-hiring/' };
const total = steps.length;
---

{
  variant === 'timeline' ? (
    <ol class="route-timeline relative grid gap-6 lg:grid-cols-6 lg:gap-4" data-route-cycle>
      {steps.map((s, i) => (
        <li class="route-step relative flex gap-4 lg:flex-col lg:gap-0" data-reveal style={`--reveal-delay:${i * 90}ms`}>
          {/* conector */}
          {i < steps.length - 1 && (
            <span
              class:list={[
                'route-connector absolute top-14 left-7 h-[calc(100%-2rem)] w-0.5 lg:top-7 lg:left-[calc(50%+1.75rem)] lg:h-0.5 lg:w-[calc(100%-2.5rem)]',
                steps[i + 1].optional ? 'border-l-2 border-dashed border-gold-400 lg:border-t-2 lg:border-l-0' : 'bg-gold-400/70',
              ]}
              aria-hidden="true"
            />
          )}
          <span
            class:list={[
              'route-dot relative z-10 flex h-14 w-14 shrink-0 items-center justify-center rounded-full font-display text-xl font-semibold ring-4 lg:mx-auto',
              s.optional ? 'bg-gold-400 text-ink-950 ring-gold-100' : 'bg-ink-950 text-gold-400 ring-white',
            ]}
          >
            {s.n}
          </span>
          <a
            href={`${t.page}#${t.anchor}-${s.n}`}
            class:list={[
              'route-card group flex-1 rounded-xl border bg-white p-4 lg:mt-4 lg:text-center',
              s.optional ? 'border-gold-400 bg-gold-50' : 'border-ink-950/10',
            ]}
          >
            <p class="text-[0.7rem] font-bold tracking-[0.14em] text-brand-700 uppercase">
              {`${t.step} ${s.n}`}
            </p>
            <h3 class="mt-1.5 font-display text-[1.02rem] leading-snug font-semibold text-ink-950">{s.title}</h3>
            <p class="mt-2 text-[0.86rem] leading-relaxed text-ink-700">{s.short}</p>
            {s.optional && (
              <p class="mt-3">
                <span class="inline-block rounded bg-gold-400 px-2 py-0.5 text-[0.7rem] font-bold tracking-[0.14em] text-ink-950 uppercase">{t.optional}</span>
              </p>
            )}
            <span class="route-more mt-3 inline-flex items-center gap-1 text-[0.78rem] font-bold text-brand-700">
              {t.more}
              <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
          </a>
        </li>
      ))}
    </ol>
  ) : (
    <ol class="grid gap-5 md:grid-flow-col md:grid-cols-2 md:grid-rows-3">
      {steps.map((s, i) => (
        <li
          id={`${t.anchor}-${s.n}`}
          class:list={[
            'route-full group relative scroll-mt-32 overflow-hidden rounded-2xl border border-l-[6px] p-6 shadow-soft transition-all duration-500 hover:-translate-y-1 hover:shadow-lift md:p-7',
            s.optional ? 'border-gold-400 bg-gold-50' : 'border-ink-950/10 border-l-ink-950 bg-white hover:border-l-gold-400',
          ]}
          data-reveal
          style={`--reveal-delay:${i * 80}ms`}
        >
          <span class="pointer-events-none absolute -top-4 right-3 font-display text-[6.5rem] leading-none font-bold text-ink-950/[0.05] transition-colors duration-500 group-hover:text-gold-400/20" aria-hidden="true">{s.n}</span>
          <div class="flex flex-wrap items-center gap-3">
            <span
              class:list={[
                'rounded-md px-2.5 py-1 text-[0.78rem] font-bold tracking-wider uppercase',
                s.optional ? 'bg-gold-400 text-ink-950' : 'bg-ink-950 text-white',
              ]}
            >
              {`${t.step} ${s.n}`}
            </span>
            {s.optional && <span class="text-[0.78rem] font-semibold text-gold-700 uppercase">{t.optional}</span>}
          </div>
          <h3 class="mt-3 font-display text-xl leading-snug font-semibold text-ink-950">{s.title}</h3>
          {s.intro && <p class="mt-2 text-[0.92rem] font-medium text-ink-800">{s.intro}</p>}
          <ul class="mt-3 space-y-2 text-[0.93rem] leading-relaxed text-ink-700">
            {s.bullets.map((b) => (
              <li class="flex gap-2.5">
                <span class:list={['mt-2 h-1.5 w-1.5 shrink-0 rounded-full', s.optional ? 'bg-gold-600' : 'bg-gold-500']} aria-hidden="true" />
                {b}
              </li>
            ))}
          </ul>
          <div class="mt-5 flex items-center gap-3" aria-hidden="true">
            <span class="flex flex-1 gap-1">
              {Array.from({ length: total }, (_, k) => (
                <span class:list={['h-1 flex-1 rounded-full transition-colors duration-500', k < s.n ? (s.optional ? 'bg-gold-500' : 'bg-brand-600') : 'bg-ink-950/10']} />
              ))}
            </span>
            <span class="text-[0.72rem] font-semibold tracking-wide text-ink-500 uppercase">{`${t.step} ${s.n} ${t.of} ${total}`}</span>
          </div>
        </li>
      ))}
    </ol>
  )
}

<style>
  .route-card {
    display: block;
    transition:
      transform 0.5s var(--ease-out-expo),
      box-shadow 0.5s var(--ease-out-expo),
      border-color 0.4s ease;
  }
  .route-card:hover,
  .route-card:focus-visible,
  .route-step.is-current .route-card {
    transform: translateY(-4px);
    border-color: var(--color-brand-500);
    box-shadow: var(--shadow-lift);
  }
  :global(html) .route-timeline > .route-step.is-visible .route-dot {
    transition:
      transform 0.5s var(--ease-spring),
      background-color 0.4s ease,
      color 0.4s ease,
      box-shadow 0.4s ease;
    transition-delay: 0s;
  }
  :global(html) .route-timeline > .route-step.is-visible:hover .route-dot,
  :global(html) .route-timeline > .route-step.is-visible.is-current .route-dot {
    transform: scale(1.12);
    background: var(--color-gold-400);
    color: var(--color-ink-950);
    box-shadow: 0 0 0 6px rgb(201 165 54 / 0.25);
  }
  .route-step.is-passed .route-connector {
    background-color: var(--color-gold-500);
  }
  @media (prefers-reduced-motion: reduce) {
    .route-card,
    :global(html) .route-timeline > .route-step.is-visible .route-dot {
      transition: none;
    }
  }
</style>

<script>
  /* Recorre los pasos uno a uno (1 → 6) para que se lean como una secuencia.
     Al pasar el cursor, el paso señalado toma el control; se detiene fuera de pantalla. */
  function initRouteCycle() {
    document.querySelectorAll<HTMLElement>('[data-route-cycle]').forEach((list) => {
      if (list.dataset.ready) return;
      list.dataset.ready = '1';
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const steps = [...list.querySelectorAll<HTMLElement>('.route-step')];
      let idx = -1;
      let timer = 0;
      let hovering = false;
      const show = (n: number) => {
        idx = n;
        steps.forEach((s, k) => {
          s.classList.toggle('is-current', k === n);
          s.classList.toggle('is-passed', k < n);
        });
      };
      const tick = () => {
        if (!hovering) show((idx + 1) % steps.length);
      };
      const start = () => {
        if (!timer) timer = window.setInterval(tick, 2200);
      };
      const stop = () => {
        clearInterval(timer);
        timer = 0;
      };
      steps.forEach((s, k) => {
        s.addEventListener('mouseenter', () => {
          hovering = true;
          show(k);
        });
        s.addEventListener('mouseleave', () => (hovering = false));
      });
      new IntersectionObserver(
        ([e]) => {
          if (e.isIntersecting) {
            if (idx < 0) setTimeout(() => show(0), 900);
            start();
          } else stop();
        },
        { threshold: 0.3 }
      ).observe(list);
    });
  }
  initRouteCycle();
  document.addEventListener('astro:page-load', initRouteCycle);
</script>
