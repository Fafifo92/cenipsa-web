---
/**
 * Gráfico «Ruta metodológica de contratación» (6 pasos).
 * - variant="timeline": línea de tiempo resumida para la home (6 hitos
 *   conectados en escritorio, vertical en móvil).
 * - variant="cards": tarjetas completas con viñetas (página «Antes de la
 *   Contratación»), pasos 1–3 y 4–6 en dos columnas, el 6 destacado como opcional.
 */
import { ROUTE_ES, ROUTE_EN } from '@/lib/route';

export interface Props {
  lang?: 'es' | 'en';
  variant?: 'timeline' | 'cards';
}
const { lang = 'es', variant = 'timeline' } = Astro.props;
const isEs = lang === 'es';
const steps = isEs ? ROUTE_ES : ROUTE_EN;
const t = isEs ? { step: 'Paso', optional: 'Opcional' } : { step: 'Step', optional: 'Optional' };
---

{
  variant === 'timeline' ? (
    <ol class="route-timeline relative grid gap-6 lg:grid-cols-6 lg:gap-4">
      {steps.map((s, i) => (
        <li class="relative flex gap-4 lg:flex-col lg:gap-0" data-reveal style={`--reveal-delay:${i * 90}ms`}>
          {/* conector */}
          {i < steps.length - 1 && (
            <span
              class:list={[
                'absolute top-14 left-7 h-[calc(100%-2rem)] w-0.5 lg:top-7 lg:left-[calc(50%+1.75rem)] lg:h-0.5 lg:w-[calc(100%-2.5rem)]',
                steps[i + 1].optional ? 'border-l-2 border-dashed border-gold-400 lg:border-t-2 lg:border-l-0' : 'bg-gold-400/70',
              ]}
              aria-hidden="true"
            />
          )}
          <span
            class:list={[
              'relative z-10 flex h-14 w-14 shrink-0 items-center justify-center rounded-full font-display text-xl font-semibold ring-4 lg:mx-auto',
              s.optional ? 'bg-gold-400 text-ink-950 ring-gold-100' : 'bg-ink-950 text-gold-400 ring-white',
            ]}
          >
            {s.n}
          </span>
          <div
            class:list={[
              'flex-1 rounded-xl border bg-white p-4 lg:mt-4 lg:text-center',
              s.optional ? 'border-gold-400 bg-gold-50' : 'border-ink-950/10',
            ]}
          >
            <p class="text-[0.7rem] font-bold tracking-[0.14em] text-brand-700 uppercase">
              {`${t.step} ${s.n}`}
              {s.optional && <span class="ml-1 rounded bg-gold-400 px-1.5 py-0.5 text-ink-950">{t.optional}</span>}
            </p>
            <h3 class="mt-1.5 font-display text-[1.02rem] leading-snug font-semibold text-ink-950">{s.title}</h3>
            <p class="mt-2 text-[0.86rem] leading-relaxed text-ink-700">{s.short}</p>
          </div>
        </li>
      ))}
    </ol>
  ) : (
    <ol class="grid gap-5 md:grid-flow-col md:grid-cols-2 md:grid-rows-3">
      {steps.map((s, i) => (
        <li
          class:list={[
            'relative overflow-hidden rounded-2xl border border-l-[6px] p-6 shadow-soft md:p-7',
            s.optional ? 'border-gold-400 bg-gold-50' : 'border-ink-950/10 border-l-ink-950 bg-white',
          ]}
          data-reveal
          style={`--reveal-delay:${i * 80}ms`}
        >
          <div class="flex flex-wrap items-center gap-3">
            <span
              class:list={[
                'rounded-md px-2.5 py-1 text-[0.78rem] font-bold tracking-wider uppercase',
                s.optional ? 'bg-gold-400 text-ink-950' : 'bg-ink-950 text-white',
              ]}
            >
              {`${t.step} ${s.n}`}
            </span>
            {s.optional && <span class="text-[0.78rem] font-semibold text-gold-700 uppercase">{t.optional}</span>}
          </div>
          <h3 class="mt-3 font-display text-xl leading-snug font-semibold text-ink-950">{s.title}</h3>
          {s.intro && <p class="mt-2 text-[0.92rem] font-medium text-ink-800">{s.intro}</p>}
          <ul class="mt-3 space-y-2 text-[0.93rem] leading-relaxed text-ink-700">
            {s.bullets.map((b) => (
              <li class="flex gap-2.5">
                <span class:list={['mt-2 h-1.5 w-1.5 shrink-0 rounded-full', s.optional ? 'bg-gold-600' : 'bg-gold-500']} aria-hidden="true" />
                {b}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  )
}
