---
/**
 * Home — CENIPSA, firma de inteligencia forense e investigación jurídica.
 * Orden (recomendaciones de la firma): propuesta de valor con bifurcación
 * B2B/B2C → segmentos → diferenciador investigación + derecho → tres pilares →
 * proceso → áreas del derecho → equipo → sellos de confianza → contenido
 * experto → preguntas frecuentes → contacto confidencial.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import PostCard from '@/components/PostCard.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import TrustSeals from '@/components/TrustSeals.astro';
import HeroImage from '@/components/HeroImage.astro';
import { SITE } from '@/lib/site';
import { PILLARS_ES, SEGMENTS_ES, PROCESS_ES, LEGAL_AREAS_ES } from '@/lib/pillars';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const HOME_FAQ_IDS = ['legal-1', 'legal-2', 'precios-1', 'precios-2'];
const faqs = (await getCollection('faq'))
  .filter((f) => HOME_FAQ_IDS.includes(f.data.id))
  .sort((a, b) => HOME_FAQ_IDS.indexOf(a.data.id) - HOME_FAQ_IDS.indexOf(b.data.id));

const segmentIcons: Record<string, string> = { empresas: 'building', personas: 'users', abogados: 'briefcase' };

const disciplines = [
  {
    n: '01',
    title: 'Derecho penal y corporativo',
    text: 'Abogados en derecho penal y sancionatorio, civil, de familia, administrativo, laboral, comercial y de propiedad intelectual.',
  },
  {
    n: '02',
    title: 'Investigación criminal y judicial',
    text: 'Investigadores formados en criminalística y ciencias forenses: dactiloscopia, balística, documentología y cadena de custodia.',
  },
  {
    n: '03',
    title: 'Ciencias sociales y comportamentales',
    text: 'Sociología, trabajo social, psicología forense y antropología aplicadas a la investigación judicial y los derechos humanos.',
  },
  {
    n: '04',
    title: 'Ingeniería e informática técnica',
    text: 'Ingenieros en electrónica y telecomunicaciones para análisis técnico, informática forense y soporte del material probatorio.',
  },
  {
    n: '05',
    title: 'Peritaje técnico',
    text: 'Peritos con conocimiento científico, técnico y metodológico para asesorar a jueces, tribunales y partes procesales.',
  },
];
---

<BaseLayout
  title="CENIPSA | Investigación Forense y Asesoría Jurídica Especializada"
  description="CENIPSA S.A.S.: inteligencia forense y asesoría legal especializada para empresas y personas en Colombia. Convertimos hechos complejos en evidencia útil y decisiones jurídicas claras."
  path="/"
  altLocalePath="/en/"
>
  <!-- ============ HERO ============ -->
  <section class="relative flex min-h-[92vh] items-center overflow-hidden bg-ink-950 pt-32 pb-20">
    <HeroImage name="plaza-bolivar" class="object-[center_35%] brightness-[1.18] saturate-[1.1]" />
    <div class="absolute inset-0 bg-gradient-to-r from-ink-950/50 via-ink-950/15 to-transparent" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-ink-950/35 to-transparent" aria-hidden="true"></div>

    <div class="container-site text-on-photo relative">
      <p class="eyebrow text-gold-400" data-reveal>
        <span class="h-px w-8 bg-gold-400" aria-hidden="true"></span>
        {SITE.brand} · {SITE.descriptor}
      </p>
      <h1 class="mt-5 max-w-4xl font-display text-[2.6rem] leading-[1.08] font-semibold text-white sm:text-6xl md:text-[4.2rem]" data-reveal style="--reveal-delay:100ms">
        Investigamos la verdad.
        <span class="mt-2 block text-gold-400">Defendemos sus derechos.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/90 md:text-xl" data-reveal style="--reveal-delay:200ms">
        Convertimos hechos complejos en evidencia útil y decisiones jurídicas claras. Inteligencia forense y
        asesoría legal especializada para empresas y personas en Colombia.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4" data-reveal style="--reveal-delay:300ms">
        <a href="/servicios/#empresas" class="btn-gold">
          <Icon name="building" class="h-5 w-5" />
          Soluciones para empresas
        </a>
        <a href="/servicios/#personas" class="btn-outline-light">
          <Icon name="users" class="h-5 w-5" />
          Orientación para personas
        </a>
      </div>
      <p class="mt-6 flex flex-wrap gap-x-7 gap-y-2 text-[0.95rem]" data-reveal style="--reveal-delay:360ms">
        <a href="/contacto/" class="link-underline font-semibold text-gold-400">Solicitar valoración confidencial</a>
        <a href="#proceso" class="link-underline font-medium text-white/90">¿Cómo trabajamos?</a>
      </p>

      <dl class="mt-14 grid max-w-3xl grid-cols-1 gap-6 border-t border-white/10 pt-8 sm:grid-cols-3" data-reveal style="--reveal-delay:420ms">
        <div>
          <dt class="text-[0.78rem] font-semibold tracking-[0.14em] text-white/80 uppercase">Razón social</dt>
          <dd class="mt-1.5 font-display text-lg leading-snug font-medium text-white">{SITE.legalName} <span class="block text-[0.9rem] text-white/80">NIT {SITE.nit}</span></dd>
        </div>
        <div>
          <dt class="text-[0.78rem] font-semibold tracking-[0.14em] text-white/80 uppercase">Sello de calidad</dt>
          <dd class="mt-1.5 font-display text-lg leading-snug font-medium text-white">Círculo de Afiliados <span class="text-gold-400">CCB</span></dd>
        </div>
        <div>
          <dt class="text-[0.78rem] font-semibold tracking-[0.14em] text-white/80 uppercase">Sede</dt>
          <dd class="mt-1.5 font-display text-lg leading-snug font-medium text-white">Torre del Reloj, Bogotá <span class="block text-[0.9rem] text-white/80">Cobertura nacional</span></dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ============ SEGMENTOS ============ -->
  <section class="section-pad" aria-labelledby="segments-title">
    <div class="container-site">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>¿A quién servimos?</p>
        <h2 id="segments-title" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">
          Soluciones según quién necesita la respuesta
        </h2>
      </div>
      <ul class="mt-12 grid gap-6 lg:grid-cols-3">
        {
          SEGMENTS_ES.map((s, i) => (
            <li class="flex flex-col rounded-2xl border border-ink-950/10 bg-white p-7 shadow-soft" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-ink-950 text-gold-400">
                <Icon name={segmentIcons[s.id]} class="h-6 w-6" />
              </span>
              <h3 class="mt-5 font-display text-xl font-semibold text-ink-950">{s.title}</h3>
              <p class="mt-2.5 text-[0.94rem] leading-relaxed text-ink-700">{s.text}</p>
              <ul class="mt-5 flex-1 space-y-2 border-t border-ink-100 pt-5 text-[0.92rem]">
                {s.links.map((l) => (
                  <li>
                    <a href={l.href} class="group inline-flex items-center gap-2 font-medium text-brand-700 hover:text-brand-600">
                      <span class="h-1.5 w-1.5 rounded-full bg-gold-500" aria-hidden="true" />
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
              <a href={`/servicios/#${s.id}`} class="btn-outline mt-6 self-start">Ver soluciones</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ DIFERENCIADOR: INVESTIGACIÓN + DERECHO ============ -->
  <section class="bg-mist section-pad" aria-labelledby="legal-title">
    <div class="container-site grid items-center gap-14 lg:grid-cols-[1.05fr_1fr]">
      <div data-reveal="left">
        <div class="relative overflow-hidden rounded-3xl bg-ink-950 p-10 shadow-lift md:p-14">
          <img src="/images/despacho-juridico.jpg" alt="" width="1600" height="1067" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink-950/75 via-ink-950/20 to-transparent" aria-hidden="true"></div>
          <p class="relative font-display text-2xl leading-snug font-medium text-white md:text-[1.7rem]">
            «No entregamos solo un informe: la evidencia se obtiene pensando, desde el primer día, en cómo
            sostenerla ante una autoridad.»
          </p>
          <p class="relative mt-6 text-[0.85rem] font-semibold tracking-[0.16em] text-gold-400 uppercase">{SITE.legalName}</p>
        </div>
      </div>
      <div data-reveal="right">
        <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>Investigación + derecho</p>
        <h2 id="legal-title" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">
          Cada investigación, con un abogado a su lado
        </h2>
        <p class="mt-5 leading-relaxed text-ink-700">
          La mayoría de firmas investiga o litiga. Nosotros hacemos ambas cosas bajo un mismo protocolo: los
          abogados orientan la recolección de evidencia para que sea lícita y útil, y los investigadores
          sustentan técnicamente cada actuación jurídica.
        </p>
        <ul class="mt-6 space-y-3 text-[0.95rem] text-ink-800">
          <li class="flex gap-3"><Icon name="shield" class="mt-0.5 h-5 w-5 shrink-0 text-brand-700" />Evidencia obtenida por medios lícitos, con cadena de custodia.</li>
          <li class="flex gap-3"><Icon name="scale" class="mt-0.5 h-5 w-5 shrink-0 text-brand-700" />Valoración jurídica de la prueba antes de actuar.</li>
          <li class="flex gap-3"><Icon name="eye" class="mt-0.5 h-5 w-5 shrink-0 text-brand-700" />Reserva y confidencialidad en todo el proceso.</li>
        </ul>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/asesoria-juridica/" class="btn-primary">Asesoría jurídica</a>
          <a href="/nosotros/" class="btn-outline">Conozca la firma</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TRES PILARES ============ -->
  <section class="section-pad" aria-labelledby="pillars-title">
    <div class="container-site">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>Nuestras soluciones</p>
        <h2 id="pillars-title" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">
          Prevenir, investigar y defender
        </h2>
        <p class="mt-4 leading-relaxed text-ink-700">
          Tres momentos de un mismo problema. Intervenimos en el que usted lo necesite —o en los tres—.
        </p>
      </div>
      <ul class="mt-12 grid gap-6 lg:grid-cols-3">
        {
          PILLARS_ES.map((p, i) => (
            <li class="flex flex-col rounded-2xl bg-brand-700 p-8 text-white shadow-lift" data-reveal style={`--reveal-delay:${i * 100}ms`}>
              <div class="flex items-center gap-4">
                <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 text-gold-400">
                  <Icon name={p.icon} class="h-6 w-6" />
                </span>
                <h3 class="font-display text-2xl font-semibold">{p.name}</h3>
              </div>
              <p class="mt-4 text-[0.95rem] leading-relaxed text-brand-100">{p.tagline}</p>
              <ul class="mt-6 flex-1 space-y-2.5 border-t border-white/15 pt-6 text-[0.92rem]">
                {p.items.map((it) => (
                  <li>
                    <a href={it.href} class="group flex items-start gap-2.5 text-white/90 transition-colors hover:text-gold-200">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-400" aria-hidden="true" />
                      {it.label}
                    </a>
                  </li>
                ))}
              </ul>
              <a href={`/servicios/#${p.id}`} class="mt-7 inline-flex items-center gap-2 text-[0.88rem] font-bold text-gold-400 hover:text-gold-200">
                Ver {p.name.toLowerCase()}
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ PROCESO ============ -->
  <section id="proceso" class="scroll-mt-28 bg-mist section-pad" aria-labelledby="process-title">
    <div class="container-site">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>¿Cómo trabajamos?</p>
        <h2 id="process-title" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">
          Claridad antes de comprometerse
        </h2>
        <p class="mt-4 leading-relaxed text-ink-700">
          Ninguna actuación empieza sin que usted conozca el alcance, los tiempos y los honorarios.
        </p>
      </div>
      <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          PROCESS_ES.map((s, i) => (
            <li class="relative rounded-2xl border border-ink-950/10 bg-white p-7" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <span class="font-display text-3xl font-semibold text-gold-600" aria-hidden="true">{s.n}</span>
              <h3 class="mt-3 font-display text-lg font-semibold text-ink-950">{s.title}</h3>
              <p class="mt-2 text-[0.93rem] leading-relaxed text-ink-700">{s.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-10" data-reveal>
        <a href="/contacto/" class="btn-primary">Solicitar valoración confidencial</a>
      </p>
    </div>
  </section>

  <!-- ============ ÁREAS DEL DERECHO ============ -->
  <section class="section-pad" aria-labelledby="areas-title">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
        <div class="max-w-2xl">
          <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>Defender · Áreas jurídicas</p>
          <h2 id="areas-title" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">
            Asesoría y representación en las principales ramas del derecho
          </h2>
        </div>
        <a href="/asesoria-juridica/" class="btn-outline">Asesoría jurídica</a>
      </div>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          LEGAL_AREAS_ES.map((a, i) => (
            <li data-reveal style={`--reveal-delay:${(i % 4) * 80}ms`}>
              <a href={a.href} class="card-lift group flex h-full flex-col p-6">
                <Icon name={a.icon} class="h-7 w-7 text-brand-700" />
                <h3 class="mt-4 font-display text-[1.08rem] font-semibold text-ink-950 transition-colors group-hover:text-brand-700">{a.label}</h3>
                <p class="mt-2 text-[0.88rem] leading-relaxed text-ink-600">{a.text}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ EQUIPO INTERDISCIPLINAR ============ -->
  <section class="bg-white section-pad" aria-labelledby="team-title">
    <div class="container-site">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr]">
        <div data-reveal="left">
          <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>Equipo interdisciplinar</p>
          <h2 id="team-title" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">
            Cinco disciplinas, un mismo caso
          </h2>
          <p class="mt-5 leading-relaxed text-ink-700">
            Los casos complejos no se resuelven desde una sola profesión. Nuestro equipo integra el derecho, la
            investigación criminal, las ciencias sociales, la ingeniería y el peritaje técnico.
          </p>
          <a href="/equipo-interdisciplinar/" class="btn-gold mt-8">Conozca el equipo</a>
        </div>
        <ol class="grid gap-4 sm:grid-cols-2">
          {
            disciplines.map((t, i) => (
              <li class:list={['rounded-2xl border-l-4 border-gold-400 bg-paper p-6', i === 4 && 'sm:col-span-2']} data-reveal style={`--reveal-delay:${i * 80}ms`}>
                <span class="font-display text-xl font-semibold text-gold-600" aria-hidden="true">{t.n}</span>
                <h3 class="mt-2 font-display text-lg font-semibold text-ink-950">{t.title}</h3>
                <p class="mt-1.5 text-[0.9rem] leading-relaxed text-ink-700">{t.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ SELLOS DE CONFIANZA ============ -->
  <section class="section-pad" aria-labelledby="trust-title">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
        <div class="max-w-2xl">
          <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>Confianza verificable</p>
          <h2 id="trust-title" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">
            Una firma que puede verificar
          </h2>
        </div>
        <a href="/garantias/" class="btn-outline">Nuestras garantías</a>
      </div>
      <div class="mt-10" data-reveal>
        <TrustSeals tone="light" />
      </div>
    </div>
  </section>

  <!-- ============ CONTENIDO EXPERTO ============ -->
  {
    posts.length > 0 && (
      <section class="bg-mist section-pad" aria-labelledby="blog-title">
        <div class="container-site">
          <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
            <div>
              <p class="eyebrow">
                <span class="h-px w-8 bg-gold-500" aria-hidden="true" />
                Contenido experto
              </p>
              <h2 id="blog-title" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">
                Análisis y guías de nuestro equipo
              </h2>
            </div>
            <a href="/blog/" class="btn-outline">Ver todas las publicaciones</a>
          </div>
          <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post, i) => (
              <PostCard post={post} index={i} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ============ PREGUNTAS FRECUENTES ============ -->
  {
    faqs.length > 0 && (
      <section class="section-pad" aria-labelledby="faq-title">
        <div class="container-site grid gap-12 lg:grid-cols-[1fr_1.6fr]">
          <div data-reveal="left">
            <p class="eyebrow">
              <span class="h-px w-8 bg-gold-500" aria-hidden="true" />
              Preguntas frecuentes
            </p>
            <h2 id="faq-title" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">
              Lo que suelen preguntarnos
            </h2>
            <a href="/faq/" class="btn-outline mt-8">Todas las preguntas</a>
          </div>
          <div class="divide-y divide-ink-100 border-y border-ink-100" data-reveal="right">
            {faqs.map((f) => (
              <details class="group py-5">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-[1.08rem] font-semibold text-ink-950 marker:hidden">
                  {f.data.question}
                  <span class="mt-1 text-gold-600 transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <div class="prose-site mt-3 text-[0.97rem]" set:html={f.data.answer} />
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBanner />
</BaseLayout>
