---
/** Índice del blog (ES): noticias y actualizaciones. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import BlogIndexBody from '@/components/BlogIndexBody.astro';
import { breadcrumbSchema } from '@/lib/seo';

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Blog', path: '/blog/' },
];
---

<BaseLayout
  title="Blog de investigación privada y derecho | CENIPSA Inteligencia Investigativa"
  description="Noticias y actualizaciones sobre investigación privada, detectives, poligrafía, GPS y asesoría jurídica en Colombia. Artículos del equipo de CENIPSA S.A.S."
  path="/blog/"
  altLocalePath="/en/blog/"
  schemas={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    eyebrow="Blog"
    title="Análisis y Contenido Experto"
    description="Guías y análisis de nuestros investigadores y abogados sobre investigación privada, prevención del fraude y derecho en Colombia."
    crumbs={crumbs}
    image="/images/blog-cenipsa-auditoria.jpg"
  />

  <BlogIndexBody />

  <CtaBanner />
</BaseLayout>
