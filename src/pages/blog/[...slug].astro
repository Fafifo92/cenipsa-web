---
/** Entrada del blog (ES): artículo íntegro con schema Article, migas y relacionados. */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogPostBody from '@/components/BlogPostBody.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { articleSchema, breadcrumbSchema } from '@/lib/seo';
import { relatedPosts } from '@/lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const path = `/blog/${post.id}/`;
const related = await relatedPosts(post);

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: post.data.title, path },
];
---

<BaseLayout
  title={`${post.data.title} | CENIPSA`}
  description={post.data.description}
  path={path}
  ogType="article"
  ogImage={post.data.image}
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString()}
  schemas={[
    articleSchema({
      title: post.data.title,
      description: post.data.description,
      path,
      datePublished: post.data.pubDate.toISOString(),
      dateModified: post.data.updatedDate?.toISOString(),
      image: post.data.image,
    }),
    breadcrumbSchema(crumbs),
  ]}
>
  <BlogPostBody post={post} related={related} lang="es" />
  <CtaBanner />
</BaseLayout>
