---
/** Entrada del blog: artículo íntegro con schema Article, migas y relacionados. */
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import PostCard from '@/components/PostCard.astro';
import { articleSchema, breadcrumbSchema } from '@/lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const path = `/blog/${post.id}/`;

const all = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
// relacionados: comparten categoría; se rellena con recientes
const related = all
  .filter((p) => p.id !== post.id)
  .sort((a, b) => {
    const shared = (p: typeof a) => p.data.categories.filter((c) => post.data.categories.includes(c)).length;
    return shared(b) - shared(a);
  })
  .slice(0, 3);

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: post.data.title, path },
];

const dateStr = post.data.pubDate.toLocaleDateString('es-CO', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={`${post.data.title} | CENIPSA`}
  description={post.data.description}
  path={path}
  ogType="article"
  ogImage={post.data.image}
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString()}
  schemas={[
    articleSchema({
      title: post.data.title,
      description: post.data.description,
      path,
      datePublished: post.data.pubDate.toISOString(),
      dateModified: post.data.updatedDate?.toISOString(),
      image: post.data.image,
    }),
    breadcrumbSchema(crumbs),
  ]}
>
  <header class="relative overflow-hidden bg-ink-950 pt-36 pb-14 md:pt-44">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -top-40 right-[-10%] h-[30rem] w-[30rem] rounded-full bg-brand-500/10 blur-3xl"></div>
    </div>
    <div class="container-site relative">
      <Breadcrumbs crumbs={crumbs.slice(0, 2)} onDark />
      <h1 class="mt-7 max-w-4xl font-display text-3xl leading-[1.15] font-semibold text-white md:text-[2.8rem]" data-reveal>
        {post.data.title}
      </h1>
      <p class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-[0.85rem] text-ink-300" data-reveal style="--reveal-delay:120ms">
        <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>Publicado: {dateStr}</time>
        <span class="hidden h-1 w-1 rounded-full bg-ink-500 sm:block" aria-hidden="true"></span>
        <span>Equipo CENIPSA — Investigadores y Abogados</span>
      </p>
      {
        post.data.categories.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2" data-reveal style="--reveal-delay:200ms">
            {post.data.categories.map((cat) => (
              <li class="rounded-lg border border-white/15 bg-white/5 px-3.5 py-1 text-[0.75rem] font-semibold tracking-wide text-ink-200">
                {cat}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </header>

  <article class="section-pad">
    <div class="container-site">
      <div class="prose-site mx-auto max-w-3xl">
        <Content />
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="bg-mist section-pad" aria-labelledby="related-posts-title">
        <div class="container-site">
          <h2 id="related-posts-title" class="eyebrow">
            <span class="h-px w-8 bg-gold-500" aria-hidden="true" />
            Artículos relacionados
          </h2>
          <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p, i) => (
              <PostCard post={p} index={i} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBanner />
</BaseLayout>
