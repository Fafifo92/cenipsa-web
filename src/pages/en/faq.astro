---
/** Frequently asked questions (EN) with accordion + FAQPage schema. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import FaqPageBody from '@/components/FaqPageBody.astro';
import type { FaqEntry } from '@/lib/faq';
import { breadcrumbSchema } from '@/lib/seo';
import faqEn from '@/data/faq.en.json';

const entries = ([...faqEn] as FaqEntry[]).sort((a, b) => a.order - b.order);

const crumbs = [
  { name: 'Home', path: '/en/' },
  { name: 'FAQ', path: '/en/faq/' },
];
---

<BaseLayout
  title="Frequently asked questions | CENIPSA"
  description="Answers to the most common questions about private investigation, detectives, polygraph, GPS tracking and legal advice in Colombia."
  path="/en/faq/"
  altLocalePath="/faq/"
  lang="en"
  schemas={[
    breadcrumbSchema(crumbs),
  ]}
>
  <PageHero
    eyebrow="FAQ"
    title="Frequently asked questions"
    description="Answers to the most common questions about our investigative and legal services."
    crumbs={crumbs}
    lang="en"
  />

  <FaqPageBody entries={entries} lang="en" />

  <CtaBanner
    lang="en"
    title="Didn't find the answer you were looking for?"
    text="Write to us and an advisor from our team will handle your case personally and confidentially."
  />
</BaseLayout>
