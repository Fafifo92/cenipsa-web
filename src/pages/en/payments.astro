---
/** Online payments (PayU) — EN. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import Icon from '@/components/Icon.astro';
import { breadcrumbSchema } from '@/lib/seo';

const crumbs = [
  { name: 'Home', path: '/en/' },
  { name: 'Payments', path: '/en/payments/' },
];

const methods = [
  'PSE', 'Visa', 'Visa Debit', 'Mastercard', 'Mastercard Debit', 'American Express',
  'Diners Club', 'Efecty', 'Baloto', 'Su Red', 'Bancolombia', 'Davivienda', 'Banco de Bogotá', 'Codensa',
];

const features = [
  'We offer several payment methods through our integration with the PayU payment platform, giving you greater security, protection for your payment methods and saved time.',
  'You may choose any payment method: Efecty, Baloto, Su Red, PSE, credit or debit cards and banks, among others.',
  'A receipt of the transfer and the status of your payment will be sent to the email registered on the platform.',
];
---

<BaseLayout
  title="Secure online payments with PayU | CENIPSA"
  description="Pay CENIPSA S.A.S. securely through the PayU platform: PSE, credit and debit cards, Efecty, Baloto and banks. Instant receipt to your email."
  path="/en/payments/"
  altLocalePath="/pagos-en-linea/"
  lang="en"
  schemas={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    eyebrow="Payments"
    title="Secure payments"
    description="We integrate with the PayU payment platform: greater security, protection for your payment methods and saved time."
    crumbs={crumbs}
    lang="en"
  />

  <section class="section-pad">
    <div class="container-site">
      <div class="grid gap-y-12 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-x-14 xl:gap-x-20">
        <div class="min-w-0 space-y-8" data-reveal>
          <ul class="space-y-5">
            {
              features.map((text) => (
                <li class="flex gap-4 rounded-2xl border border-ink-100 bg-white p-6 shadow-soft">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-700">
                    <Icon name="shield" class="h-4.5 w-4.5" />
                  </span>
                  <p class="leading-relaxed text-ink-700">{text}</p>
                </li>
              ))
            }
          </ul>

          <div class="rounded-3xl bg-ink-950 p-8 text-white md:p-10">
            <h2 class="font-display text-2xl font-semibold">How do you make your payment?</h2>
            <p class="mt-3 leading-relaxed text-ink-200">
              Request your personalized payment link from our team: we will send it by email or WhatsApp with the
              details of the contracted service, so you can pay securely through PayU.
            </p>
            <div class="mt-7 flex flex-wrap gap-4">
              <a href="/en/contact/" class="btn-gold">Request payment link</a>
              <a href="/en/online-services/" class="btn-outline-light">Online services</a>
            </div>
          </div>
        </div>

        <aside class="lg:sticky lg:top-28 lg:self-start" data-reveal>
          <div class="rounded-3xl border border-ink-100 bg-white p-6 shadow-soft">
            <h2 class="font-display text-lg font-semibold text-ink-950">Available payment methods</h2>
            <ul class="mt-5 flex flex-wrap gap-2">
              {
                methods.map((m) => (
                  <li class="rounded-lg border border-ink-200 bg-paper px-3 py-1.5 text-[0.8rem] font-semibold text-ink-700">
                    {m}
                  </li>
                ))
              }
            </ul>
            <p class="mt-6 flex items-center gap-2 border-t border-ink-100 pt-5 text-[0.85rem] font-semibold text-brand-700">
              <Icon name="shield" class="h-4 w-4" />
              Payments secured by PayU
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CtaBanner lang="en" />
</BaseLayout>
