---
/** English home — full parity with the Spanish home. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import FingerprintMotif from '@/components/FingerprintMotif.astro';
import Icon from '@/components/Icon.astro';
import PostCard from '@/components/PostCard.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { CONTACT } from '@/lib/site';
import { allPosts } from '@/lib/blog';

const posts = (await allPosts()).slice(0, 3);

const services = [
  { icon: 'user-search', title: 'Personal investigation', text: 'Solve personal matters through investigative and technological tools, in full confidence.', href: '/en/personal-investigation/' },
  { icon: 'building', title: 'Corporate investigation', text: 'Has your company suffered corruption, bribery or information leaks? We find the evidence.', href: '/en/corporate-investigation/' },
  { icon: 'scale', title: 'Legal advice & representation', text: 'Restore your infringed rights with our team of specialized lawyers.', href: '/en/legal-advice/' },
  { icon: 'microscope', title: 'Criminalistics', text: 'Judicial investigation services with scientific rigor and chain of custody.', href: '/en/criminalistics/' },
  { icon: 'satellite', title: 'GPS satellite tracking', text: 'Protect your vehicles and assets with our GPS satellite tracking platform.', href: '/en/gps-tracking/' },
  { icon: 'pulse', title: 'Polygraph testing', text: 'Corporate and investigative polygraph exams performed by certified experts.', href: '/en/polygraph/' },
];

const specialties = [
  { label: 'Corporate & investigative polygraph', href: '/en/polygraph/' },
  { label: 'Family & asset investigation', href: '/en/personal-investigation/' },
  { label: 'Locating people or families', href: '/en/personal-investigation/' },
  { label: 'Background checks for foreign nationality', href: '/en/personal-investigation/' },
  { label: 'Pre-marital background investigation', href: '/en/personal-investigation/' },
  { label: 'GPS satellite tracker with microphone', href: '/en/gps-tracking/' },
  { label: 'Homicide & domestic violence investigation', href: '/en/criminalistics/' },
  { label: 'Forensic financial audit', href: '/en/corporate-investigation/' },
  { label: 'Theft & fraud investigation in companies', href: '/en/corporate-investigation/' },
  { label: 'Security studies & HR support', href: '/en/corporate-investigation/' },
  { label: 'Pre-hire risk study', href: '/en/corporate-investigation/' },
  { label: 'Infidelity investigation', href: '/en/personal-investigation/' },
  { label: 'Electronic sweep', href: '/en/electronic-sweep/' },
  { label: 'Services for lawyers', href: '/en/services-for-lawyers/' },
];

const team = [
  { n: '01', title: 'Law', text: 'Lawyers specialized in criminal, civil, family, administrative, labor, commercial and intellectual property law.' },
  { n: '02', title: 'Criminal & judicial investigation', text: 'Investigators skilled in criminalistics, forensic and exact sciences; specialists in fingerprinting, ballistics, chain of custody and document examination.' },
  { n: '03', title: 'Social sciences', text: 'Professionals in sociology, social work, anthropology and history, specialists in judicial investigation, social behavior and human rights.' },
  { n: '04', title: 'Electronics & communications engineering', text: 'Engineers skilled in the technical handling of specialized investigation software and hardware, serving the strength of the evidence.' },
  { n: '05', title: 'Forensic expertise', text: 'Experts with scientific, technical and methodological knowledge to advise judges and courts.' },
];

const cities = [
  { label: 'Private detectives in Bogotá', href: '/en/services/', icon: 'map-pin' },
  { label: 'Private detectives in Medellín', href: '/en/services/', icon: 'map-pin' },
  { label: 'Private detectives in Cali', href: '/en/services/', icon: 'map-pin' },
  { label: 'Private detectives across Colombia', href: '/en/services/', icon: 'globe' },
];
---

<BaseLayout
  title="Private investigators & lawyers in Bogotá, Colombia | CENIPSA"
  description="CENIPSA S.A.S. — private investigators and lawyers in Bogotá, Colombia. Personal and corporate investigation, polygraph, criminalistics, GPS tracking and legal advice."
  path="/en/"
  altLocalePath="/"
  lang="en"
>
  <!-- ============ HERO ============ -->
  <section class="relative flex min-h-[92vh] items-center overflow-hidden bg-ink-950 pt-32 pb-20">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -top-32 left-[-10%] h-[36rem] w-[36rem] rounded-full bg-brand-500/12 blur-3xl"></div>
      <div class="absolute right-[-8%] bottom-[-20%] h-[32rem] w-[32rem] rounded-full bg-gold-500/8 blur-3xl"></div>
      <FingerprintMotif class="absolute right-[-4rem] top-1/2 h-[120%] w-auto -translate-y-1/2 text-brand-400/15 md:right-[4%]" />
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_55%,rgb(10_20_30/0.7))]"></div>
    </div>
    <div class="container-site relative">
      <p class="eyebrow text-brand-300" data-reveal>
        <span class="h-px w-8 bg-gold-400" aria-hidden="true"></span>
        Investigators &amp; lawyers in Colombia
      </p>
      <h1 class="mt-5 max-w-4xl font-display text-[2.6rem] leading-[1.08] font-semibold text-white sm:text-6xl md:text-[4.2rem]" data-reveal style="--reveal-delay:100ms">
        Investigative and legal advisory.
        <span class="mt-2 block bg-gradient-to-r from-brand-300 via-brand-400 to-gold-300 bg-clip-text text-transparent">We find the truth.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-200 md:text-xl" data-reveal style="--reveal-delay:200ms">
        We uncover the truth behind the facts under investigation. Private detectives and lawyers with experience,
        technology, competence and confidentiality, serving you across the country.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4" data-reveal style="--reveal-delay:300ms">
        <a href={CONTACT.whatsappHref} target="_blank" rel="noopener" class="btn-gold">
          Tell us your case
          <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href="/en/services/" class="btn-outline-light">Explore our services</a>
      </div>
      <dl class="mt-16 grid max-w-3xl grid-cols-2 gap-6 border-t border-white/10 pt-8 sm:grid-cols-3" data-reveal style="--reveal-delay:420ms">
        <div>
          <dt class="text-[0.78rem] font-semibold tracking-[0.14em] text-ink-400 uppercase">Experience</dt>
          <dd class="mt-1.5 font-display text-3xl font-semibold text-white">10+ years</dd>
        </div>
        <div>
          <dt class="text-[0.78rem] font-semibold tracking-[0.14em] text-ink-400 uppercase">Quality seal</dt>
          <dd class="mt-1.5 font-display text-lg leading-snug font-medium text-white">Bogotá Chamber of Commerce</dd>
        </div>
        <div>
          <dt class="text-[0.78rem] font-semibold tracking-[0.14em] text-ink-400 uppercase">Coverage</dt>
          <dd class="mt-1.5 font-display text-lg leading-snug font-medium text-white">Bogotá · Medellín · Cali</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ============ ABOUT ============ -->
  <section class="section-pad" aria-labelledby="about-title-en">
    <div class="container-site grid items-center gap-14 lg:grid-cols-[1.05fr_1fr]">
      <div data-reveal="left">
        <div class="relative">
          <div class="absolute -top-6 -left-6 h-24 w-24 rounded-3xl border-2 border-gold-300" aria-hidden="true"></div>
          <div class="relative overflow-hidden rounded-3xl bg-ink-950 p-10 shadow-lift md:p-14">
            <FingerprintMotif class="absolute -right-10 -bottom-16 h-[120%] w-auto text-brand-400/20" />
            <p class="relative font-display text-2xl leading-snug font-medium text-white md:text-[1.7rem]">
              «Our main goal is to contribute to justice, truth and the restoration of rights for those who have
              been victims of different violations.»
            </p>
            <p class="relative mt-6 text-[0.85rem] font-semibold tracking-[0.16em] text-brand-300 uppercase">CENIPSA S.A.S.</p>
          </div>
        </div>
      </div>
      <div data-reveal="right">
        <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>Who we are</p>
        <h2 id="about-title-en" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">
          Trust and track record in judicial investigation and law
        </h2>
        <p class="mt-5 leading-relaxed text-ink-700">
          CENIPSA S.A.S. is a company with extensive experience in private investigation and law. Our team of
          experienced private detectives provides technical guidance on investigative and judicial matters so that
          our clients can prevent and resolve their present conflicts and face future ones.
        </p>
        <p class="mt-4 leading-relaxed text-ink-700">
          Our investigative and legal methodologies are the perfect blend of experience, technology, competence and
          confidentiality, with services such as
          <a href="/en/gps-tracking/" class="font-medium text-brand-700 underline decoration-brand-300 underline-offset-4 hover:text-brand-600">GPS satellite tracking</a>
          and <a href="/en/polygraph/" class="font-medium text-brand-700 underline decoration-brand-300 underline-offset-4 hover:text-brand-600">polygraph testing</a>,
          backed by our investigators across Colombia.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/en/about-us/" class="btn-primary">About us</a>
          <a href="/en/guarantees/" class="btn-outline">Our guarantees</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="bg-mist section-pad" aria-labelledby="services-title-en">
    <div class="container-site">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>Services</p>
        <h2 id="services-title-en" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">
          Comprehensive investigative and legal solutions
        </h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((s, i) => (
            <a href={s.href} class="card-lift group relative flex flex-col overflow-hidden p-7" data-reveal style={`--reveal-delay:${(i % 3) * 100}ms`}>
              <span class="absolute top-0 left-0 h-1 w-full origin-left scale-x-0 bg-gradient-to-r from-brand-500 to-gold-400 transition-transform duration-500 [transition-timing-function:var(--ease-out-expo)] group-hover:scale-x-100" aria-hidden="true" />
              <span class="flex h-13 w-13 items-center justify-center rounded-2xl bg-brand-50 text-brand-700 transition-all duration-500 group-hover:bg-brand-600 group-hover:text-white">
                <Icon name={s.icon} class="h-6.5 w-6.5" />
              </span>
              <h3 class="mt-5 font-display text-[1.25rem] font-semibold text-ink-950 transition-colors group-hover:text-brand-700">{s.title}</h3>
              <p class="mt-2.5 flex-1 text-[0.94rem] leading-relaxed text-ink-600">{s.text}</p>
              <span class="mt-5 inline-flex items-center gap-2 text-[0.85rem] font-bold text-brand-700">
                Learn more
                <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
      <p class="mt-10 text-center" data-reveal>
        <a href="/en/services/" class="btn-primary">All services</a>
      </p>
    </div>
  </section>

  <!-- ============ SPECIALTIES (marquee) ============ -->
  <section class="overflow-hidden border-y border-ink-100 bg-paper py-10" aria-label="Investigative specialties">
    <div class="marquee-mask">
      <ul class="flex w-max animate-marquee gap-3 motion-reduce:animate-none motion-reduce:flex-wrap motion-reduce:justify-center" data-marquee>
        {
          [...specialties, ...specialties].map((sp, i) => (
            <li aria-hidden={i >= specialties.length ? 'true' : undefined}>
              <a
                href={sp.href}
                tabindex={i >= specialties.length ? -1 : undefined}
                class="inline-flex items-center gap-2.5 rounded-lg border border-ink-200 bg-white px-5 py-2.5 text-[0.88rem] font-semibold whitespace-nowrap text-ink-700 shadow-soft transition-colors hover:border-brand-400 hover:text-brand-700"
              >
                <span class="h-1.5 w-1.5 rounded-full bg-gold-500" aria-hidden="true" />
                {sp.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ INTERDISCIPLINARY TEAM ============ -->
  <section class="section-pad" aria-labelledby="team-title-en">
    <div class="container-site">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr]">
        <div data-reveal="left">
          <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>Interdisciplinary team</p>
          <h2 id="team-title-en" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">
            Five disciplines at the service of the truth
          </h2>
          <p class="mt-5 leading-relaxed text-ink-700">
            Personal and corporate legal investigations demand diverse strategies and investigative methodologies.
            Our team has the expertise and integrity needed at the epistemological, theoretical, methodological,
            practical and ethical level in the search for the truth.
          </p>
          <a href="/en/interdisciplinary-team/" class="btn-primary mt-8">Meet our team</a>
        </div>
        <ol class="space-y-1">
          {
            team.map((t, i) => (
              <li class="group flex gap-6 rounded-2xl border-b border-ink-100 p-6 transition-colors duration-300 last:border-0 hover:bg-mist" data-reveal style={`--reveal-delay:${i * 80}ms`}>
                <span class="font-display text-2xl font-semibold text-gold-600" aria-hidden="true">{t.n}</span>
                <div>
                  <h3 class="font-display text-lg font-semibold text-ink-950 transition-colors group-hover:text-brand-700">{t.title}</h3>
                  <p class="mt-1.5 text-[0.93rem] leading-relaxed text-ink-600">{t.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ COVERAGE ============ -->
  <section class="relative overflow-hidden bg-ink-950 section-pad" aria-labelledby="coverage-title-en">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute top-[-30%] left-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-500/10 blur-3xl"></div>
    </div>
    <div class="container-site relative">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow text-brand-300"><span class="h-px w-8 bg-gold-400" aria-hidden="true"></span>Nationwide coverage</p>
        <h2 id="coverage-title-en" class="mt-4 font-display text-3xl font-semibold text-white md:text-4xl">
          Private detectives in Colombia's main cities
        </h2>
        <p class="mt-4 leading-relaxed text-ink-300">
          Thanks to our technological solutions and virtual service channels, we reduce geographic, logistical and
          operational barriers to handle cases throughout the country.
        </p>
      </div>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          cities.map((c, i) => (
            <li data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <a href={c.href} class="group flex h-full flex-col justify-between gap-8 rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all duration-400 hover:-translate-y-1.5 hover:border-brand-400/60 hover:bg-white/10">
                <Icon name={c.icon} class="h-7 w-7 text-gold-300" />
                <span class="font-display text-lg leading-snug font-semibold text-white transition-colors group-hover:text-brand-200">
                  {c.label}
                  <svg class="mt-3 h-4 w-4 text-brand-300 transition-transform duration-300 group-hover:translate-x-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ BLOG ============ -->
  {
    posts.length > 0 && (
      <section class="section-pad" aria-labelledby="blog-title-en">
        <div class="container-site">
          <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
            <div>
              <p class="eyebrow">
                <span class="h-px w-8 bg-gold-500" aria-hidden="true" />
                Blog
              </p>
              <h2 id="blog-title-en" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">
                News and updates
              </h2>
            </div>
            <a href="/en/blog/" class="btn-outline">View all articles</a>
          </div>
          <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post, i) => (
              <PostCard post={post} index={i} lang="en" />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBanner lang="en" />
</BaseLayout>

<style>
  .marquee-mask {
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-mask {
      mask-image: none;
    }
    [data-marquee] {
      width: 100% !important;
    }
  }
</style>
