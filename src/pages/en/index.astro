---
/** English home — mirrors the structure of the Spanish home. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import PostCard from '@/components/PostCard.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import TrustSeals from '@/components/TrustSeals.astro';
import HeroImage from '@/components/HeroImage.astro';
import { SITE } from '@/lib/site';
import { PILLARS_EN, PROCESS_EN } from '@/lib/pillars';
import { allPosts } from '@/lib/blog';

const posts = (await allPosts()).slice(0, 3);

const segments = [
  {
    id: 'empresas',
    icon: 'building',
    title: 'Companies',
    text: 'Due diligence, internal fraud, staff reliability, information security and corporate legal defense.',
    links: [
      { label: 'Corporate Investigation', href: '/en/corporate-investigation/' },
      { label: 'Reliability Testing', href: '/en/polygraph/' },
      { label: 'Electronic Sweeps', href: '/en/electronic-sweep/' },
      { label: 'Legal Advice', href: '/en/legal-advice/' },
    ],
  },
  {
    id: 'personas',
    icon: 'users',
    title: 'Individuals & Families',
    text: 'Verification of personal and asset-related facts in full confidence, with legal support in family, inheritance and criminal matters.',
    links: [
      { label: 'Personal & Asset Investigation', href: '/en/personal-investigation/' },
      { label: 'Legal Advice & Representation', href: '/en/legal-advice/' },
    ],
  },
  {
    id: 'abogados',
    icon: 'briefcase',
    title: 'Law Firms & Legal Departments',
    text: 'Evidentiary support for your litigation: locating people, asset investigation, expert reports and evidence assessment.',
    links: [
      { label: 'Services for Law Firms and Legal Departments', href: '/en/services-for-lawyers/' },
      { label: 'Criminalistics & Expert Reports', href: '/en/criminalistics/' },
    ],
  },
];

const disciplines = [
  { n: '01', title: 'Criminal & Corporate Law', text: 'Lawyers in criminal, civil, family, administrative, labor, commercial and intellectual property law.' },
  { n: '02', title: 'Criminal & Judicial Investigation', text: 'Investigators trained in criminalistics and forensic science: fingerprinting, ballistics, document examination and chain of custody.' },
  { n: '03', title: 'Social & Behavioral Sciences', text: 'Sociology, social work, forensic psychology and anthropology applied to judicial investigation and human rights.' },
  { n: '04', title: 'Engineering & Technical IT', text: 'Electronics and telecommunications engineers for technical analysis, digital forensics and evidentiary support.' },
  { n: '05', title: 'Technical Expert Witnesses', text: 'Experts with scientific, technical and methodological knowledge to advise judges, courts and parties.' },
];
---

<BaseLayout
  title="CENIPSA | Forensic Investigation & Specialized Legal Advice in Colombia"
  description="CENIPSA S.A.S.: forensic intelligence and specialized legal advice for companies and individuals in Colombia. We turn complex facts into useful evidence and clear legal decisions."
  path="/en/"
  altLocalePath="/"
  lang="en"
>
  <!-- ============ HERO ============ -->
  <section class="relative flex min-h-[92vh] items-center overflow-hidden bg-ink-950 pt-32 pb-20">
    <HeroImage name="plaza-bolivar" class="object-[center_35%] brightness-[1.15] contrast-[1.05] saturate-[1.1]" />
    <div class="absolute inset-0 bg-gradient-to-r from-ink-950/50 via-ink-950/25 to-ink-950/10" aria-hidden="true"></div>
    <div class="container-site text-on-photo relative">
      <p class="eyebrow text-gold-400" data-reveal>
        <span class="h-px w-8 bg-gold-400" aria-hidden="true"></span>
        {SITE.brand} · {SITE.descriptorEn}
      </p>
      <h1 class="mt-5 max-w-4xl font-display text-[2.6rem] leading-[1.08] font-semibold text-white sm:text-6xl md:text-[4.2rem]" data-reveal style="--reveal-delay:100ms">
        We investigate the truth.
        <span class="mt-2 block text-gold-400">We defend your rights.</span>
      </h1>
      <p class="mt-6 max-w-2xl rounded-lg bg-ink-950/45 px-4 py-3 text-lg leading-relaxed text-white backdrop-blur-[2px] md:text-xl" data-reveal style="--reveal-delay:200ms">
        We turn complex facts into useful evidence and clear legal decisions. Forensic intelligence and specialized
        legal advice for companies and individuals in Colombia.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4" data-reveal style="--reveal-delay:300ms">
        <a href="/en/services/#empresas" class="btn-gold">
          <Icon name="building" class="h-5 w-5" />
          Solutions for companies
        </a>
        <a href="/en/services/#personas" class="btn-outline-light">
          <Icon name="users" class="h-5 w-5" />
          Guidance for individuals
        </a>
      </div>
      <p class="mt-6 flex flex-wrap gap-x-7 gap-y-2 text-[0.95rem]" data-reveal style="--reveal-delay:360ms">
        <a href="/en/contact/" class="link-underline font-semibold text-gold-400">Request a confidential assessment</a>
        <a href="#process" class="link-underline font-medium text-white/90">How do we work?</a>
      </p>
      <dl class="mt-14 grid max-w-3xl grid-cols-1 gap-6 border-t border-white/10 pt-8 sm:grid-cols-3" data-reveal style="--reveal-delay:420ms">
        <div>
          <dt class="text-[0.78rem] font-semibold tracking-[0.14em] text-white/80 uppercase">Registered company</dt>
          <dd class="mt-1.5 font-display text-lg leading-snug font-medium text-white">{SITE.legalName} <span class="block text-[0.9rem] text-white/80">NIT {SITE.nit}</span></dd>
        </div>
        <div>
          <dt class="text-[0.78rem] font-semibold tracking-[0.14em] text-white/80 uppercase">Quality seal</dt>
          <dd class="mt-1.5 font-display text-lg leading-snug font-medium text-white">Bogotá Chamber of Commerce <span class="text-gold-400">Affiliates</span></dd>
        </div>
        <div>
          <dt class="text-[0.78rem] font-semibold tracking-[0.14em] text-white/80 uppercase">Office</dt>
          <dd class="mt-1.5 font-display text-lg leading-snug font-medium text-white">Torre del Reloj, Bogotá <span class="block text-[0.9rem] text-white/80">Nationwide coverage</span></dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ============ SEGMENTS ============ -->
  <section class="section-pad" aria-labelledby="segments-title-en">
    <div class="container-site">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>Who we serve</p>
        <h2 id="segments-title-en" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">
          Solutions based on who needs the answer
        </h2>
      </div>
      <ul class="mt-12 grid gap-6 lg:grid-cols-3">
        {
          segments.map((s, i) => (
            <li class="flex flex-col rounded-2xl border border-ink-950/10 bg-white p-7 shadow-soft" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-ink-950 text-gold-400">
                <Icon name={s.icon} class="h-6 w-6" />
              </span>
              <h3 class="mt-5 font-display text-xl font-semibold text-ink-950">{s.title}</h3>
              <p class="mt-2.5 text-[0.94rem] leading-relaxed text-ink-700">{s.text}</p>
              <ul class="mt-5 flex-1 space-y-2 border-t border-ink-100 pt-5 text-[0.92rem]">
                {s.links.map((l) => (
                  <li>
                    <a href={l.href} class="inline-flex items-center gap-2 font-medium text-brand-700 hover:text-brand-600">
                      <span class="h-1.5 w-1.5 rounded-full bg-gold-500" aria-hidden="true" />
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
              <a href={`/en/services/#${s.id}`} class="btn-outline mt-6 self-start">See solutions</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ DIFFERENTIATOR ============ -->
  <section class="bg-mist section-pad" aria-labelledby="legal-title-en">
    <div class="container-site grid items-center gap-14 lg:grid-cols-[1.05fr_1fr]">
      <div data-reveal="left">
        <div class="relative overflow-hidden rounded-3xl bg-ink-950 p-10 shadow-lift md:p-14">
          <img src="/images/despacho-juridico.jpg" alt="" width="1200" height="800" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink-950/75 via-ink-950/20 to-transparent" aria-hidden="true"></div>
          <p class="relative font-display text-2xl leading-snug font-medium text-white md:text-[1.7rem]">
            «We don't just hand over a report: evidence is gathered from day one with a view to how it will stand
            before an authority.»
          </p>
          <p class="relative mt-6 text-[0.85rem] font-semibold tracking-[0.16em] text-gold-400 uppercase">{SITE.legalName}</p>
        </div>
      </div>
      <div data-reveal="right">
        <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>Investigation + law</p>
        <h2 id="legal-title-en" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">
          Every investigation, with a lawyer by your side
        </h2>
        <p class="mt-5 leading-relaxed text-ink-700">
          Most firms either investigate or litigate. We do both under a single protocol: lawyers guide evidence
          gathering so it is lawful and useful, and investigators provide the technical grounds for every legal action.
        </p>
        <ul class="mt-6 space-y-3 text-[0.95rem] text-ink-800">
          <li class="flex gap-3"><Icon name="shield" class="mt-0.5 h-5 w-5 shrink-0 text-brand-700" />Lawfully obtained evidence, with chain of custody.</li>
          <li class="flex gap-3"><Icon name="scale" class="mt-0.5 h-5 w-5 shrink-0 text-brand-700" />Legal assessment of the evidence before acting.</li>
          <li class="flex gap-3"><Icon name="eye" class="mt-0.5 h-5 w-5 shrink-0 text-brand-700" />Discretion and confidentiality throughout.</li>
        </ul>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/en/legal-advice/" class="btn-primary">Legal advice</a>
          <a href="/en/about-us/" class="btn-outline">About the firm</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PILLARS ============ -->
  <section class="section-pad" aria-labelledby="pillars-title-en">
    <div class="container-site">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>Our solutions</p>
        <h2 id="pillars-title-en" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">
          Prevent, investigate and defend
        </h2>
        <p class="mt-4 leading-relaxed text-ink-700">Three moments of the same problem. We step in where you need us — or across all three.</p>
      </div>
      <ul class="mt-12 grid gap-6 lg:grid-cols-3">
        {
          PILLARS_EN.map((p, i) => (
            <li class="flex flex-col rounded-2xl bg-brand-700 p-8 text-white shadow-lift" data-reveal style={`--reveal-delay:${i * 100}ms`}>
              <div class="flex items-center gap-4">
                <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 text-gold-400">
                  <Icon name={p.icon} class="h-6 w-6" />
                </span>
                <h3 class="font-display text-2xl font-semibold">{p.name}</h3>
              </div>
              <p class="mt-4 text-[0.95rem] leading-relaxed text-brand-100">{p.tagline}</p>
              <ul class="mt-6 flex-1 space-y-2.5 border-t border-white/15 pt-6 text-[0.92rem]">
                {p.items.map((it) => (
                  <li>
                    <a href={it.href} class="flex items-start gap-2.5 text-white/90 transition-colors hover:text-gold-200">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-400" aria-hidden="true" />
                      {it.label}
                    </a>
                  </li>
                ))}
              </ul>
              <a href={`/en/services/#${p.id}`} class="mt-7 inline-flex items-center gap-2 text-[0.88rem] font-bold text-gold-400 hover:text-gold-200">
                {p.name}
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section id="process" class="scroll-mt-28 bg-mist section-pad" aria-labelledby="process-title-en">
    <div class="container-site">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>How do we work?</p>
        <h2 id="process-title-en" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">Clarity before you commit</h2>
        <p class="mt-4 leading-relaxed text-ink-700">No action begins until you know the scope, timeline and fees.</p>
      </div>
      <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          PROCESS_EN.map((s, i) => (
            <li class="rounded-2xl border border-ink-950/10 bg-white p-7" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <span class="font-display text-3xl font-semibold text-gold-600" aria-hidden="true">{s.n}</span>
              <h3 class="mt-3 font-display text-lg font-semibold text-ink-950">{s.title}</h3>
              <p class="mt-2 text-[0.93rem] leading-relaxed text-ink-700">{s.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-10" data-reveal>
        <a href="/en/contact/" class="btn-primary">Request a confidential assessment</a>
      </p>
    </div>
  </section>

  <!-- ============ TEAM ============ -->
  <section class="bg-white section-pad" aria-labelledby="team-title-en">
    <div class="container-site">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr]">
        <div data-reveal="left">
          <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>Interdisciplinary team</p>
          <h2 id="team-title-en" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">Five disciplines, one case</h2>
          <p class="mt-5 leading-relaxed text-ink-700">
            Complex cases are not solved from a single profession. Our team brings together law, criminal
            investigation, social sciences, engineering and technical expert work.
          </p>
          <a href="/en/interdisciplinary-team/" class="btn-gold mt-8">Meet the team</a>
        </div>
        <ol class="grid gap-4 sm:grid-cols-2">
          {
            disciplines.map((t, i) => (
              <li class:list={['rounded-2xl border-l-4 border-gold-400 bg-paper p-6', i === 4 && 'sm:col-span-2']} data-reveal style={`--reveal-delay:${i * 80}ms`}>
                <span class="font-display text-xl font-semibold text-gold-600" aria-hidden="true">{t.n}</span>
                <h3 class="mt-2 font-display text-lg font-semibold text-ink-950">{t.title}</h3>
                <p class="mt-1.5 text-[0.9rem] leading-relaxed text-ink-700">{t.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ TRUST ============ -->
  <section class="section-pad" aria-labelledby="trust-title-en">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
        <div class="max-w-2xl">
          <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>Verifiable trust</p>
          <h2 id="trust-title-en" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">A firm you can verify</h2>
        </div>
        <a href="/en/guarantees/" class="btn-outline">Our guarantees</a>
      </div>
      <div class="mt-10" data-reveal>
        <TrustSeals lang="en" tone="light" />
      </div>
    </div>
  </section>

  <!-- ============ BLOG ============ -->
  {
    posts.length > 0 && (
      <section class="bg-mist section-pad" aria-labelledby="blog-title-en">
        <div class="container-site">
          <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
            <div>
              <p class="eyebrow">
                <span class="h-px w-8 bg-gold-500" aria-hidden="true" />
                Expert content
              </p>
              <h2 id="blog-title-en" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">Analysis and guides from our team</h2>
            </div>
            <a href="/en/blog/" class="btn-outline">View all articles</a>
          </div>
          <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post, i) => (
              <PostCard post={post} index={i} lang="en" />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBanner lang="en" />
</BaseLayout>
