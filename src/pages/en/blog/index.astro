---
/** Índice del blog (chrome EN): posts en español con encabezados en inglés + aviso. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import BlogIndexBody from '@/components/BlogIndexBody.astro';
import BlogSpanishNotice from '@/components/BlogSpanishNotice.astro';

const crumbs = [
  { name: 'Home', path: '/en/' },
  { name: 'Blog', path: '/en/blog/' },
];
---

<BaseLayout
  title="Blog | CENIPSA Investigative & Legal Intelligence"
  description="News and updates on private investigation, detectives, polygraph, GPS tracking and legal advice in Colombia. Articles by the CENIPSA S.A.S. team (in Spanish)."
  path="/en/blog/"
  canonicalPath="/blog/"
  altLocalePath="/blog/"
  lang="en"
  noindex
>
  <PageHero
    eyebrow="Blog"
    title="Analysis and Expert Content"
    description="Analysis and guides from our investigators and lawyers. Articles are written in Spanish by our editorial team."
    crumbs={crumbs}
    lang="en"
    image="/images/blog-cenipsa-auditoria.jpg"
  />

  <BlogIndexBody lang="en" />

  <CtaBanner lang="en" />
  <BlogSpanishNotice esUrl="/blog/" />
</BaseLayout>
