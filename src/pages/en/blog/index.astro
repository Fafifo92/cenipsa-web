---
/** Índice del blog (chrome EN): posts en español con encabezados en inglés + aviso. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import PostCard from '@/components/PostCard.astro';
import BlogSpanishNotice from '@/components/BlogSpanishNotice.astro';
import { allPosts } from '@/lib/blog';

const posts = await allPosts();

const crumbs = [
  { name: 'Home', path: '/en/' },
  { name: 'Blog', path: '/en/blog/' },
];
---

<BaseLayout
  title="Blog | CENIPSA Private Investigators & Lawyers"
  description="News and updates on private investigation, detectives, polygraph, GPS tracking and legal advice in Colombia. Articles by the CENIPSA S.A.S. team (in Spanish)."
  path="/en/blog/"
  canonicalPath="/blog/"
  altLocalePath="/blog/"
  lang="en"
  noindex
>
  <PageHero
    eyebrow="Blog"
    title="News and updates"
    description="Analysis and guides from our investigators and lawyers. Articles are written in Spanish by our editorial team."
    crumbs={crumbs}
    lang="en"
  />

  <section class="section-pad">
    <div class="container-site">
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, i) => <PostCard post={post} index={i} lang="en" />)}
      </div>
    </div>
  </section>

  <CtaBanner lang="en" />
  <BlogSpanishNotice esUrl="/blog/" />
</BaseLayout>
