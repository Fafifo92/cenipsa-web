---
/** How we work — English counterpart of /como-trabajamos/. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import ProcessFlow from '@/components/ProcessFlow.astro';
import Icon from '@/components/Icon.astro';
import { breadcrumbSchema } from '@/lib/seo';
import { PROCESS_EN } from '@/lib/pillars';

const crumbs = [
  { name: 'Home', path: '/en/' },
  { name: 'About us', path: '/en/about-us/' },
  { name: 'How we work', path: '/en/how-we-work/' },
];

const principles = [
  { icon: 'lock', title: 'Confidentiality', text: 'Professional secrecy, non-disclosure agreements and access limited to the assigned team.' },
  { icon: 'scale', title: 'Lawful evidence', text: 'All evidence is gathered lawfully and with a chain of custody so it is admissible.' },
  { icon: 'users', title: 'Interdisciplinary team', text: 'Lawyers, investigators, experts and engineers work the case under one protocol.' },
  { icon: 'eye', title: 'Transparency', text: 'You know the scope, timeline and fees before any action is taken.' },
];
---

<BaseLayout
  title="How we work | Confidential case process | CENIPSA"
  description="How CENIPSA handles each case: we receive your request, identify the type of case, carry out an initial assessment and propose scope, timeline and fees, in full confidence."
  path="/en/how-we-work/"
  altLocalePath="/como-trabajamos/"
  lang="en"
  schemas={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    eyebrow="About us"
    title="How we work"
    description="For confidentiality reasons we do not publish our clients. What we do show is how we work: a clear, discreet process backed by legal counsel from the first contact."
    crumbs={crumbs}
    lang="en"
  />

  <section class="section-pad" aria-labelledby="flow-title-en">
    <div class="container-site">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>Case process</p>
        <h2 id="flow-title-en" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">From request to proposal, in four steps</h2>
      </div>
      <div class="mt-12">
        <ProcessFlow steps={PROCESS_EN} />
      </div>
      <p class="mt-12" data-reveal>
        <a href="/en/contact/" class="btn-primary">Request a confidential assessment</a>
      </p>
    </div>
  </section>

  <section class="bg-mist section-pad" aria-labelledby="principles-title-en">
    <div class="container-site">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>Throughout the case</p>
        <h2 id="principles-title-en" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">What we guarantee at every stage</h2>
      </div>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          principles.map((p, i) => (
            <li class="rounded-2xl border border-ink-950/10 bg-white p-6" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <Icon name={p.icon} class="h-7 w-7 text-brand-700" />
              <h3 class="mt-4 font-display text-lg font-semibold text-ink-950">{p.title}</h3>
              <p class="mt-2 text-[0.92rem] leading-relaxed text-ink-700">{p.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-10" data-reveal>
        <a href="/en/guarantees/" class="btn-outline">See our guarantees</a>
      </p>
    </div>
  </section>

  <CtaBanner lang="en" />
</BaseLayout>
