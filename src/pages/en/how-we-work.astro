---
/** How we work — English counterpart of /como-trabajamos/ (methodological flowchart). */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import MethodFlow from '@/components/MethodFlow.astro';
import { breadcrumbSchema } from '@/lib/seo';

const crumbs = [
  { name: 'Home', path: '/en/' },
  { name: 'About us', path: '/en/about-us/' },
  { name: 'How we work', path: '/en/how-we-work/' },
];

const stages = [
  {
    title: 'Stage 1: Investigation and forensic analysis',
    tag: 'Prevent and collect',
    text: 'It begins by scoping the case and receiving the materials provided by the client. Using OSINT methodology, open-source analysis and digital or field expert work, our team builds the forensic timeline, profiles the subjects of interest and maps their relationships, all under strict chain-of-custody and ISO/IEC 27037 protocols.',
    result: 'Phase 1 deliverable: initial body of evidence, verified indicators and relationship map.',
  },
  {
    title: 'Stage 2: Evidentiary support and assessment',
    tag: 'Analyze and filter',
    text: 'Technical-forensic interviews and specialized questioning are carried out. CENIPSA’s criminal and corporate lawyers then put the evidence through a strict filter of relevance, conduciveness, usefulness and procedural legality, structuring the hypotheses on a sound legal basis.',
    result: 'Phase 2 deliverable: legally supported evidence matrix and procedural risk weighting.',
  },
  {
    title: 'Stage 3: Pre-litigation opinion and strategic briefing',
    tag: 'Decide and act',
    text: 'The written forensic expert report is consolidated with its digital annexes. The legal team issues a reasoned pre-litigation opinion analyzing the possible legal classification of the conduct (for example, unauthorized system access, fraud, forgery or breach of trust), the likelihood of success and recommended actions, followed by an executive briefing with the client.',
    result: 'Final result: clear legal decisions to file a criminal complaint, mount a defense or apply preventive corporate measures.',
  },
];
---

<BaseLayout
  title="How we work | Step by step of a forensic and pre-litigation investigation | CENIPSA"
  description="The step-by-step of a professional forensic and pre-litigation investigation at CENIPSA: forensic investigation, evidentiary assessment and pre-litigation opinion."
  path="/en/how-we-work/"
  altLocalePath="/como-trabajamos/"
  lang="en"
  schemas={[breadcrumbSchema(crumbs)]}
>
  <PageHero eyebrow="How we work" title="The step-by-step of a professional forensic and pre-litigation investigation" crumbs={crumbs} lang="en" />

  <section class="section-pad" aria-labelledby="intro-title-en">
    <div class="container-site">
      <div class="max-w-3xl" data-reveal>
        <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>Introduction</p>
        <h2 id="intro-title-en" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">Why procedural rigor matters</h2>
        <p class="mt-5 text-[1.05rem] leading-relaxed text-ink-700">
          Facing suspected fraud, an asset dispute or a violation of rights demands absolute precision. Evidence obtained
          informally or outside the law can void any legal action or create further criminal liability. At CENIPSA S.A.S.
          we combine field investigative intelligence with review by criminal and corporate lawyers so that every piece of
          evidence is lawful, relevant and legally admissible.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-mist section-pad" aria-labelledby="flow-title-en">
    <div class="container-site">
      <div class="max-w-3xl" data-reveal>
        <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>Official infographic</p>
        <h2 id="flow-title-en" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">CENIPSA methodological flowchart</h2>
      </div>
      <div class="mx-auto mt-10 max-w-5xl">
        <MethodFlow lang="en" />
      </div>
    </div>
  </section>

  <section class="section-pad" aria-labelledby="stages-title-en">
    <div class="container-site">
      <h2 id="stages-title-en" class="font-display text-3xl font-semibold text-ink-950 md:text-4xl" data-reveal>The methodological stages</h2>
      <ol class="mt-10 space-y-6">
        {
          stages.map((s, i) => (
            <li class="rounded-2xl border border-ink-950/10 bg-white p-7 md:p-9" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <p class="text-[0.78rem] font-semibold tracking-[0.14em] text-brand-700 uppercase">{s.tag}</p>
              <h3 class="mt-2 font-display text-xl font-semibold text-ink-950 md:text-2xl">{s.title}</h3>
              <p class="mt-4 leading-relaxed text-ink-700">{s.text}</p>
              <p class="mt-5 border-l-4 border-gold-400 bg-paper px-5 py-3 font-semibold text-ink-950">{s.result}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBanner
    lang="en"
    title="Do you need a confidential assessment for your company or personal situation?"
    text="At CENIPSA S.A.S. we turn complex facts into useful evidence and clear legal decisions. Contact us for a discreet initial consultation with our multidisciplinary team."
  />
</BaseLayout>
