---
/** Preguntas frecuentes con acordeón + schema FAQPage. */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import FaqPageBody from '@/components/FaqPageBody.astro';
import type { FaqEntry } from '@/lib/faq';
import { faqSchema, breadcrumbSchema } from '@/lib/seo';

const entries: FaqEntry[] = (await getCollection('faq')).map((f) => f.data).sort((a, b) => a.order - b.order);
const items = entries.map((f) => ({ question: f.question, answer: f.answer }));

const stripHtml = (html: string) => html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Preguntas frecuentes', path: '/faq/' },
];
---

<BaseLayout
  title="Preguntas frecuentes | CENIPSA Inteligencia Investigativa"
  description="Preguntas frecuentes sobre legalidad y confidencialidad, investigación personal y familiar, servicios empresariales, servicios para abogados, precios, tiempos y citas. Asistente virtual de CENIPSA."
  path="/faq/"
  altLocalePath="/en/faq/"
  schemas={[
    faqSchema(items.map((it) => ({ question: it.question, answer: stripHtml(it.answer) }))),
    breadcrumbSchema(crumbs),
  ]}
>
  <PageHero
    eyebrow="FAQ"
    title="Preguntas frecuentes"
    description="Resolvemos las dudas más comunes sobre nuestros servicios investigativos y jurídicos."
    crumbs={crumbs}
  />

  <FaqPageBody entries={entries} />

  <CtaBanner
    title="¿No encuentras la respuesta que buscas?"
    text="Escríbenos y un asesor de nuestro equipo resolverá tu caso de forma personalizada y confidencial."
  />
</BaseLayout>
