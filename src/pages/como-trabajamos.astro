---
/**
 * Cómo trabajamos — reemplaza «Casos de éxito» (la firma no publica a sus
 * contratantes por confidencialidad). Contenido y flujograma metodológico
 * enviados por la firma (PÁGINA WEB OBSERVACIONES, nov. 2026).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import MethodFlow from '@/components/MethodFlow.astro';
import { breadcrumbSchema } from '@/lib/seo';
import { CONTACT } from '@/lib/site';

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Nosotros', path: '/nosotros/' },
  { name: 'Cómo trabajamos', path: '/como-trabajamos/' },
];

const stages = [
  {
    title: 'Etapa 1: Investigación y análisis forense',
    tag: 'Prevenir y colectar',
    text: 'Inicia con la delimitación del caso y la recepción de insumos aportados por el contratante. A través de metodología OSINT, análisis de fuentes abiertas y peritaje informático o de campo, nuestro equipo construye la cronología forense, perfila a los sujetos de interés y elabora grafos de vinculación relacional. Todo el proceso se adelanta bajo estrictos protocolos de cadena de custodia e ISO/IEC 27037.',
    result: 'Entregable fase 1: acervo probatorio inicial, indicadores verificados y mapa de vinculaciones relacionales.',
  },
  {
    title: 'Etapa 2: Sustentación y evaluación probatoria',
    tag: 'Analizar y filtrar',
    text: 'Se adelantan diligencias de entrevistas técnico-forenses con contexto e interrogatorios especializados. Posteriormente, los abogados penalistas y especialistas corporativos de CENIPSA someten la evidencia a un filtro estricto de pertinencia, conducencia, utilidad y legalidad procesal, estructurando las hipótesis delictivas u operativas con fundamentación jurídica.',
    result: 'Entregable fase 2: matriz de evidencia legalmente sustentada y ponderación de riesgos procesales.',
  },
  {
    title: 'Etapa 3: Dictamen prejurídico y socialización estratégica',
    tag: 'Decidir y actuar',
    text: 'Consolidación del informe pericial forense escrito con sus respectivos anexos digitales. El área jurídica emite el dictamen prejurídico motivado, donde analiza la eventual adecuación típica de conductas (por ejemplo, acceso abusivo a sistemas, fraude, falsedad o abuso de confianza), la vocación de éxito ante las autoridades y las recomendaciones de actuación. Finalmente, se realiza una sesión de socialización ejecutiva con el cliente.',
    result: 'Resultado final: decisiones jurídicas claras para interponer denuncia penal, iniciar defensa o aplicar medidas preventivas corporativas.',
  },
];
---

<BaseLayout
  title="Cómo trabajamos | Paso a paso de una investigación forense y prejurídica | CENIPSA"
  description="Conozca el paso a paso de una investigación forense y prejurídica profesional en CENIPSA: investigación y análisis forense, evaluación probatoria y dictamen prejurídico."
  path="/como-trabajamos/"
  altLocalePath="/en/how-we-work/"
  schemas={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    eyebrow="Cómo trabajamos"
    title="Conozca el paso a paso de una investigación forense y prejurídica profesional"
    crumbs={crumbs}
  />

  <section class="section-pad" aria-labelledby="intro-title">
    <div class="container-site">
      <div class="max-w-3xl" data-reveal>
        <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>Introducción</p>
        <h2 id="intro-title" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">
          La importancia del rigor procesal en la investigación
        </h2>
        <p class="mt-5 text-[1.05rem] leading-relaxed text-ink-700">
          En el entorno corporativo y personal actual, enfrentar una sospecha de fraude, un conflicto patrimonial o una
          vulneración de derechos exige actuar con absoluta precisión. Presentar pruebas obtenidas de forma empírica o al
          margen de la ley puede anular cualquier acción judicial o generar responsabilidades penales adicionales. En
          CENIPSA S.A.S., combinamos la inteligencia investigativa de campo con la evaluación de abogados penalistas y
          corporativos para garantizar que cada elemento de prueba sea lícito, pertinente y legalmente conducente.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-mist section-pad" aria-labelledby="flow-title">
    <div class="container-site">
      <div class="max-w-3xl" data-reveal>
        <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>Infografía oficial</p>
        <h2 id="flow-title" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">Flujograma metodológico CENIPSA</h2>
      </div>
      <div class="mx-auto mt-10 max-w-5xl">
        <MethodFlow />
      </div>
    </div>
  </section>

  <section class="section-pad" aria-labelledby="stages-title">
    <div class="container-site">
      <div class="max-w-3xl" data-reveal>
        <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>Explicación detallada</p>
        <h2 id="stages-title" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">Las etapas metodológicas</h2>
      </div>
      <ol class="mt-10 space-y-6">
        {
          stages.map((s, i) => (
            <li class="rounded-2xl border border-ink-950/10 bg-white p-7 md:p-9" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <p class="text-[0.78rem] font-semibold tracking-[0.14em] text-brand-700 uppercase">{s.tag}</p>
              <h3 class="mt-2 font-display text-xl font-semibold text-ink-950 md:text-2xl">{s.title}</h3>
              <p class="mt-4 leading-relaxed text-ink-700">{s.text}</p>
              <p class="mt-5 border-l-4 border-gold-400 bg-paper px-5 py-3 font-semibold text-ink-950">{s.result}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBanner
    title="¿Requiere una evaluación confidencial para su empresa o situación personal?"
    text={`En CENIPSA S.A.S. convertimos hechos complejos en evidencia útil y decisiones jurídicas claras. Contáctenos para una orientación inicial reservada con nuestro equipo multidisciplinario. ${CONTACT.emailInfo} · ${CONTACT.whatsapp}`}
  />
</BaseLayout>
