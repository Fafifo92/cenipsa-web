---
/**
 * Índice de servicios organizado en los tres pilares (Prevenir · Investigar ·
 * Defender), con las áreas del derecho y una entrada por perfil de cliente
 * (#empresas, #personas, #abogados) — destino de los CTA B2B/B2C de la home.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import Icon from '@/components/Icon.astro';
import { breadcrumbSchema } from '@/lib/seo';
import { PILLARS_ES, SEGMENTS_ES, LEGAL_AREAS_ES } from '@/lib/pillars';

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Servicios', path: '/servicios/' },
];

const segmentIcons: Record<string, string> = { empresas: 'building', personas: 'users', abogados: 'briefcase' };
const segmentCta: Record<string, string> = {
  empresas: '/contacto/?tipo=empresarial',
  personas: '/contacto/?tipo=personal',
  abogados: '/contacto/?tipo=empresarial',
};
---

<BaseLayout
  title="Servicios de inteligencia forense y asesoría jurídica | CENIPSA"
  description="Prevenir, investigar y defender: debida diligencia, fraude corporativo, investigación personal y patrimonial, criminalística, auditoría forense y asesoría jurídica en Colombia."
  path="/servicios/"
  altLocalePath="/en/services/"
  schemas={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    eyebrow="Servicios"
    title="Prevenir, investigar y defender"
    description="Inteligencia forense y asesoría legal especializada, organizadas en tres momentos de un mismo problema. Cada servicio cuenta con respaldo jurídico."
    crumbs={crumbs}
  />

  <!-- Perfiles de cliente -->
  <section class="section-pad" aria-labelledby="profiles-title">
    <div class="container-site">
      <h2 id="profiles-title" class="sr-only">Soluciones por perfil</h2>
      <ul class="grid gap-6 lg:grid-cols-3">
        {
          SEGMENTS_ES.map((s, i) => (
            <li id={s.id} class="flex scroll-mt-28 flex-col rounded-2xl border border-ink-950/10 bg-white p-7 shadow-soft target:ring-2 target:ring-gold-400" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-ink-950 text-gold-400">
                <Icon name={segmentIcons[s.id]} class="h-6 w-6" />
              </span>
              <h3 class="mt-5 font-display text-xl font-semibold text-ink-950">{s.title}</h3>
              <p class="mt-2.5 text-[0.94rem] leading-relaxed text-ink-700">{s.text}</p>
              <ul class="mt-5 flex-1 space-y-2 border-t border-ink-100 pt-5 text-[0.92rem]">
                {s.links.map((l) => (
                  <li>
                    <a href={l.href} class="inline-flex items-center gap-2 font-medium text-brand-700 hover:text-brand-600">
                      <span class="h-1.5 w-1.5 rounded-full bg-gold-500" aria-hidden="true" />
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
              <a href={segmentCta[s.id]} class="btn-primary mt-6 self-start">Solicitar valoración confidencial</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Pilares -->
  {
    PILLARS_ES.map((p, idx) => (
      <section id={p.id} class:list={['scroll-mt-24 section-pad', idx % 2 === 0 && 'bg-mist']} aria-labelledby={`${p.id}-title`}>
        <div class="container-site grid gap-10 lg:grid-cols-[1fr_1.6fr]">
          <div data-reveal="left">
            <p class="eyebrow">
              <span class="h-px w-8 bg-gold-500" aria-hidden="true" />
              Pilar {idx + 1} de 3
            </p>
            <h2 id={`${p.id}-title`} class="mt-4 flex items-center gap-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-700 text-gold-400">
                <Icon name={p.icon} class="h-6 w-6" />
              </span>
              {p.name}
            </h2>
            <p class="mt-4 leading-relaxed text-ink-700">{p.tagline}</p>
          </div>
          <ul class="grid gap-4 sm:grid-cols-2">
            {p.items.map((it, i) => (
              <li data-reveal style={`--reveal-delay:${(i % 2) * 80}ms`}>
                <a href={it.href} class="card-lift group flex h-full items-center justify-between gap-4 p-5">
                  <span class="font-display text-[1.02rem] leading-snug font-semibold text-ink-950 transition-colors group-hover:text-brand-700">{it.label}</span>
                  <svg class="h-4 w-4 shrink-0 text-gold-600 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <!-- Áreas del derecho -->
  <section class="section-pad" aria-labelledby="areas-title">
    <div class="container-site">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow"><span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>Defender · Áreas jurídicas</p>
        <h2 id="areas-title" class="mt-4 font-display text-3xl font-semibold text-ink-950 md:text-4xl">Áreas del derecho</h2>
      </div>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          LEGAL_AREAS_ES.map((a, i) => (
            <li data-reveal style={`--reveal-delay:${(i % 4) * 80}ms`}>
              <a href={a.href} class="card-lift group flex h-full flex-col p-6">
                <Icon name={a.icon} class="h-7 w-7 text-brand-700" />
                <h3 class="mt-4 font-display text-[1.08rem] font-semibold text-ink-950 group-hover:text-brand-700">{a.label}</h3>
                <p class="mt-2 text-[0.88rem] leading-relaxed text-ink-600">{a.text}</p>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-10 flex flex-wrap gap-4" data-reveal>
        <a href="/asesoria-juridica/" class="btn-outline">Asesoría y representación jurídica</a>
        <a href="/servicios-especiales/" class="btn-outline">Servicios para Firmas de Abogados y Departamentos Jurídicos</a>
      </p>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
