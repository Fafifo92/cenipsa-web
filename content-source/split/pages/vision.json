  "content": "[mk_page_section bg_image=\"http://www.inteligenciainvestigativa.com/wp-content/uploads/2016/06/visionfondo.jpg\" attachment=\"fixed\" bg_stretch=\"true\" sidebar=\"sidebar-1\"][vc_column width=\"1/2\" css=\".vc_custom_1465491567302{padding-top: 5% !important;padding-right: 5% !important;padding-bottom: 5% !important;padding-left: 5% !important;background-image: url(http://www.inteligenciainvestigativa.com/wp-content/uploads/2016/06/fondo.png?id=218) !important;background-position: 0 0 !important;background-repeat: repeat !important;}\"][vc_column_text]\r\n<div class=\"page\" title=\"Page 7\">\r\n<div class=\"section\">\r\n<div class=\"layoutArea\">\r\n<div class=\"column\">\r\n<div class=\"page\" title=\"Page 8\">\r\n<div class=\"section\">\r\n<div class=\"layoutArea\">\r\n<div class=\"column\">\r\n<h3 style=\"text-align: justify;\"><span style=\"color: #ffffff;\">VISIÓN</span></h3>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ffffff;\">CENIPSA SAS en la siguiente década estará́ posicionada en el primer lugar como agencia de investigación socio-jurídica nacional e internacional. Garantizará los estándares de calidad en investigación con innovación y tecnología moderna, que nos convertirá en el soporte permanente de nuestros contratantes mediante la asesoría eficaz, analítica y oportuna con resultados contundentes en la identificación de la verdad y la justicia.</span></p>\r\n\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n[/vc_column_text][/vc_column][vc_column width=\"1/2\"][/vc_column][/mk_page_section]",
